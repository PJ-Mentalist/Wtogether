from java.lang import Boolean, Integer, Long
from org.telegram.tgnet import TLRPC
from org.telegram.messenger import MessageObject, NotificationCenter

__id__ = "wtogether"
__name__ = "Wtogether"
__description__ = "Совместный просмотр видео в своём плеере: ведущий управляет, у всех синхронно, лобби, чат и звонок"
__author__ = "Wtogether"
__version__ = "2.0.0"
# Иконка: имя_набора_стикеров/номер. После создания своего набора через @Stickers замени на "ИмяНабора/0"
__icon__ = "exteraPlugins/1"
__category__ = ["media", "chats"]

TAG = "#wt1 "
TAG_RE = re.compile(r"#wt1 (\{.*\})", re.S)
ZW0, ZW1, ZWM = "​", "‌", "⁣"

TICK_MS = 300            # цикл плеера
HEARTBEAT_S = 3.0        # ведущий шлёт состояние во время воспроизведения
COUNTDOWN_MS = 3000      # отсчёт перед стартом
SMALL_DRIFT = 150        # мс: меньше — не трогаем
BIG_DRIFT = 2000         # мс: больше — перематываем, между — подстраиваем скорость
NUDGE = 0.08             # насколько ускоряем/замедляем при подстройке
NUDGE_DONE = 80          # мс: до какого расхождения подтягиваем, раз начали
PING_EVERY = 20.0        # с: зритель регулярно уточняет разницу часов
SEEK_COOLDOWN = 1.5      # с: после перемотки даём плееру устояться
DELETE_EVERY = 4.0       # с: пакетное удаление своих служебных сообщений
SKIP_MS = 10000
SPEEDS = [1.0, 1.25, 1.5, 2.0, 0.75]
MAX_GUESTS = 10

ACCENT = "#3E8EF7"
DARK = "#99000000"
PANEL = "#CC0B0F14"
ONLINE = "#4CD964"
OFFLINE = "#8E8E93"
WAITING = "#FFB340"


# ---------------- утилиты ----------------

def now_ms():
    return int(time.time() * 1000)


def fmt_time(ms):
    s = max(0, int(ms) // 1000)
    h, s = divmod(s, 3600)
    m, s = divmod(s, 60)
    return f"{h}:{m:02d}:{s:02d}" if h else f"{m}:{s:02d}"


def zw_encode(obj):
    raw = json.dumps(obj, separators=(",", ":")).encode("utf-8")
    return ZWM + "".join(ZW1 if bit == "1" else ZW0 for b in raw for bit in f"{b:08b}") + ZWM


def zw_decode(text):
    i = text.find(ZWM)
    j = text.find(ZWM, i + 1) if i >= 0 else -1
    if i < 0 or j < 0:
        return None
    bits = "".join("1" if c == ZW1 else "0" for c in text[i + 1:j] if c in (ZW0, ZW1))
    if not bits or len(bits) % 8:
        return None
    try:
        return json.loads(bytes(int(bits[k:k + 8], 2) for k in range(0, len(bits), 8)).decode("utf-8"))
    except Exception:
        return None


def extract_cmd(text):
    if not text:
        return None
    if ZWM in text:
        cmd = zw_decode(text)
        if cmd:
            return cmd
    m = TAG_RE.search(text)
    if m:
        try:
            return json.loads(m.group(1))
        except Exception:
            return None
    return None


def has_cmd(text):
    return bool(text) and (ZWM in text or TAG in text)


def expected_pos(st, room_now):
    """Где сейчас должен быть ведущий по последнему состоянию."""
    if not st["p"]:
        return st["pos"]
    return st["pos"] + max(0, room_now - st["ts"]) * st["r"]


def plan_correction(st, room_now, cur, playing, nudging=False):
    """Что сделать зрителю, чтобы совпасть с ведущим.
    Возвращает (play: bool, seek_to: int|None, speed: float, nudging: bool).
    Подстройка скорости включается при расхождении > SMALL_DRIFT
    и держится, пока не сойдёмся до NUDGE_DONE (гистерезис)."""
    target = expected_pos(st, room_now)
    diff = cur - target
    if not st["p"]:
        return False, (int(target) if abs(diff) > SMALL_DRIFT else None), st["r"], False
    if not playing:
        # запускаемся — сразу встаём точно в нужное место
        return True, (int(target) if abs(diff) > NUDGE_DONE else None), st["r"], False
    if abs(diff) > BIG_DRIFT:
        return True, int(target), st["r"], False
    if abs(diff) > SMALL_DRIFT or (nudging and abs(diff) > NUDGE_DONE):
        return True, None, st["r"] * (1 - NUDGE if diff > 0 else 1 + NUDGE), True
    return True, None, st["r"], False


# ---------------- обёртки Java-интерфейсов ----------------

def listeners():
    """Классы-обёртки создаются при первом использовании, чтобы плагин грузился даже без них."""
    if hasattr(listeners, "cache"):
        return listeners.cache
    from android.media import MediaPlayer
    from android.widget import SeekBar
    from android.content import DialogInterface

    class Prepared(dynamic_proxy(MediaPlayer.OnPreparedListener)):
        def __init__(self, fn):
            super().__init__()
            self.fn = fn

        def onPrepared(self, mp):
            self.fn(mp)

    class Completed(dynamic_proxy(MediaPlayer.OnCompletionListener)):
        def __init__(self, fn):
            super().__init__()
            self.fn = fn

        def onCompletion(self, mp):
            self.fn(mp)

    class Failed(dynamic_proxy(MediaPlayer.OnErrorListener)):
        def __init__(self, fn):
            super().__init__()
            self.fn = fn

        def onError(self, mp, what, extra):
            self.fn(what, extra)
            return True

    class Seek(dynamic_proxy(SeekBar.OnSeekBarChangeListener)):
        def __init__(self, on_change, on_start, on_stop):
            super().__init__()
            self.on_change, self.on_start, self.on_stop = on_change, on_start, on_stop

        def onProgressChanged(self, sb, progress, from_user):
            self.on_change(int(progress), bool(from_user))

        def onStartTrackingTouch(self, sb):
            self.on_start()

        def onStopTrackingTouch(self, sb):
            self.on_stop(int(sb.getProgress()))

    class Keys(dynamic_proxy(DialogInterface.OnKeyListener)):
        def __init__(self, fn):
            super().__init__()
            self.fn = fn

        def onKey(self, dialog, code, event):
            if code == 4:  # «назад»
                if event.getAction() == 1:
                    self.fn()
                return True
            return False

    class Dismissed(dynamic_proxy(DialogInterface.OnDismissListener)):
        def __init__(self, fn):
            super().__init__()
            self.fn = fn

        def onDismiss(self, dialog):
            self.fn()

    listeners.cache = dict(Prepared=Prepared, Completed=Completed, Failed=Failed,
                           Seek=Seek, Keys=Keys, Dismissed=Dismissed)
    return listeners.cache


class NewMessages(NotificationCenterDelegate):
    """Запасной путь приёма команд — если хук обновлений не сработал."""
    plugin = None

    def didReceivedNotification(self, id, account, args):
        try:
            if id == NotificationCenter.didReceiveNewMessages:
                self.plugin.on_new_messages(int(args[0]), args[1])
        except Exception as e:
            self.plugin.err(f"didReceiveNewMessages: {e}")


# ---------------- плеер ----------------

class Player:
    """Полноэкранный плеер Wtogether."""

    def __init__(self, plugin, mo):
        from android.app import Dialog
        from android import R as AR
        from android.view import WindowManager

        self.p = plugin
        self.mo = mo
        self.alive = True
        self.vv = None
        self.mp = None
        self.prepared = False
        self.duration = 0
        self.dragging = False
        self.seek_block_until = 0.0
        self.speed = 1.0
        self.countdown_at = 0
        self.bubbles = []
        self.heads_sig = None
        self.controls_shown = True
        self.last_beat = 0.0
        self.local_path = None

        self.act = plugin.activity()
        if self.act is None:
            raise RuntimeError("нет активного окна")
        self.prev_orientation = self.act.getRequestedOrientation()
        self.build()

        L = listeners()
        self.dialog = Dialog(self.act, AR.style.Theme_Black_NoTitleBar_Fullscreen)
        self.dialog.setContentView(self.root)
        self.dialog.setCancelable(False)
        self.dialog.setOnKeyListener(L["Keys"](lambda: self.p.safe(self.p.ask_close)))
        self.dialog.setOnDismissListener(L["Dismissed"](lambda: self.p.safe(self.on_dismissed)))
        w = self.dialog.getWindow()
        w.addFlags(WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON)
        w.setSoftInputMode(16)  # adjustResize
        self.dialog.show()

        self.load()
        run_on_ui_thread(self.tick, TICK_MS)

    # ---------- построение интерфейса ----------

    def build(self):
        from android.widget import FrameLayout, LinearLayout, TextView, SeekBar, EditText, VideoView
        from android.view import Gravity
        from android.graphics import Color, Typeface
        from android.graphics.drawable import GradientDrawable
        from android.content.res import ColorStateList
        from org.telegram.messenger import AndroidUtilities

        self.FL, self.LL, self.TV = FrameLayout, LinearLayout, TextView
        self.Gravity, self.Color, self.Typeface, self.GD = Gravity, Color, Typeface, GradientDrawable
        dp = self.dp = lambda v: AndroidUtilities.dp(float(v))
        ctx = self.act
        host = self.p.is_host()

        self.root = FrameLayout(ctx)
        self.root.setBackgroundColor(Color.BLACK)
        self.root.setOnClickListener(OnClickListener(lambda v: self.toggle_controls()))

        # видео
        self.vv = VideoView(ctx)
        self.root.addView(self.vv, FrameLayout.LayoutParams(-1, -1, Gravity.CENTER))

        # центр: загрузка, лобби, отсчёт
        self.center = LinearLayout(ctx)
        self.center.setOrientation(LinearLayout.VERTICAL)
        self.center.setGravity(Gravity.CENTER)
        self.big = self.text("", 44.0, True)
        self.big.setGravity(Gravity.CENTER)
        self.center.addView(self.big, LinearLayout.LayoutParams(-2, -2))
        self.info = self.text("", 15.0)
        self.info.setGravity(Gravity.CENTER)
        self.info.setPadding(dp(24), dp(6), dp(24), dp(6))
        self.center.addView(self.info, LinearLayout.LayoutParams(-2, -2))
        self.start_btn = self.pill("▶  Начать для всех", ACCENT, lambda: self.p.host_start())
        slp = LinearLayout.LayoutParams(-2, -2)
        slp.topMargin = dp(16)
        self.center.addView(self.start_btn, slp)
        self.start_btn.setVisibility(8)
        self.root.addView(self.center, FrameLayout.LayoutParams(-1, -2, Gravity.CENTER))

        # верх: закрыть, заголовок, головы
        self.top = LinearLayout(ctx)
        self.top.setOrientation(LinearLayout.HORIZONTAL)
        self.top.setGravity(Gravity.CENTER_VERTICAL)
        self.top.setPadding(dp(8), dp(28), dp(12), dp(10))
        self.top.setBackground(self.grad(True))
        close = self.round_btn("✕", DARK, 40, lambda: self.p.ask_close(), 16.0)
        self.top.addView(close, LinearLayout.LayoutParams(dp(40), dp(40)))
        titles = LinearLayout(ctx)
        titles.setOrientation(LinearLayout.VERTICAL)
        self.title = self.text("Wtogether", 16.0, True)
        self.title.setSingleLine(True)
        self.subtitle = self.text("", 12.5)
        self.subtitle.setSingleLine(True)
        self.subtitle.setAlpha(0.8)
        titles.addView(self.title)
        titles.addView(self.subtitle)
        tlp = LinearLayout.LayoutParams(0, -2, 1.0)
        tlp.leftMargin = dp(10)
        self.top.addView(titles, tlp)
        self.faces = LinearLayout(ctx)
        self.faces.setOrientation(LinearLayout.HORIZONTAL)
        self.faces.setPadding(dp(4), dp(4), dp(4), dp(4))
        self.faces.setBackground(self.shape(DARK, dp(20)))
        self.faces.setOnClickListener(OnClickListener(lambda v: self.p.open_panel()))
        self.top.addView(self.faces, LinearLayout.LayoutParams(-2, -2))
        self.root.addView(self.top, FrameLayout.LayoutParams(-1, -2, Gravity.TOP))

        # лента сообщений
        self.feed = LinearLayout(ctx)
        self.feed.setOrientation(LinearLayout.VERTICAL)
        flp = FrameLayout.LayoutParams(dp(280), -2, Gravity.BOTTOM | Gravity.START)
        flp.leftMargin = dp(12)
        flp.bottomMargin = dp(212)
        self.root.addView(self.feed, flp)

        # низ: ползунок, кнопки, сообщение
        self.bottom = LinearLayout(ctx)
        self.bottom.setOrientation(LinearLayout.VERTICAL)
        self.bottom.setPadding(dp(12), dp(16), dp(12), dp(14))
        self.bottom.setBackground(self.grad(False))
        self.bottom.setOnClickListener(OnClickListener(lambda v: None))  # не прячем по нажатию на панель

        row = LinearLayout(ctx)
        row.setOrientation(LinearLayout.HORIZONTAL)
        row.setGravity(Gravity.CENTER_VERTICAL)
        self.time_cur = self.text("0:00", 12.5, True)
        row.addView(self.time_cur)
        self.seek = SeekBar(ctx)
        self.seek.setMax(1000)
        try:
            tint = ColorStateList.valueOf(Color.parseColor(ACCENT))
            self.seek.setProgressTintList(tint)
            self.seek.setThumbTintList(tint)
        except Exception:
            pass
        L = listeners()
        self.seek.setOnSeekBarChangeListener(L["Seek"](self.on_seek_change, self.on_seek_start, self.on_seek_stop))
        self.seek.setEnabled(host)
        row.addView(self.seek, LinearLayout.LayoutParams(0, -2, 1.0))
        self.time_all = self.text("0:00", 12.5, True)
        row.addView(self.time_all)
        self.bottom.addView(row, LinearLayout.LayoutParams(-1, -2))

        ctl = LinearLayout(ctx)
        ctl.setOrientation(LinearLayout.HORIZONTAL)
        ctl.setGravity(Gravity.CENTER)
        p = self.p
        self.btn_play = None
        self.btn_speed = None
        if host:
            items = [("−10", DARK, lambda: p.host_skip(-SKIP_MS), 48, 15.0),
                     ("▶", ACCENT, p.host_toggle, 62, 24.0),
                     ("+10", DARK, lambda: p.host_skip(SKIP_MS), 48, 15.0),
                     ("1×", DARK, p.host_speed, 48, 14.0)]
        else:
            items = [("🔄", DARK, p.catch_up, 48, 18.0)]
        items += [("📞", DARK, p.start_call, 48, 18.0), ("⤢", DARK, self.rotate, 48, 18.0)]
        for text, color, fn, size, ts in items:
            b = self.round_btn(text, color, size, fn, ts)
            if text == "▶":
                self.btn_play = b
            if text == "1×":
                self.btn_speed = b
            blp = LinearLayout.LayoutParams(dp(size), dp(size))
            blp.leftMargin = dp(6)
            blp.rightMargin = dp(6)
            ctl.addView(b, blp)
        clp = LinearLayout.LayoutParams(-1, -2)
        clp.topMargin = dp(6)
        self.bottom.addView(ctl, clp)

        if not host:
            self.lock = self.text("🔒 Управляет ведущий", 12.5)
            self.lock.setGravity(Gravity.CENTER)
            self.lock.setAlpha(0.75)
            llp = LinearLayout.LayoutParams(-1, -2)
            llp.topMargin = dp(6)
            self.bottom.addView(self.lock, llp)

        say = LinearLayout(ctx)
        say.setOrientation(LinearLayout.HORIZONTAL)
        say.setGravity(Gravity.CENTER_VERTICAL)
        self.input = EditText(ctx)
        self.input.setHint("Сообщение всем…")
        self.input.setTextColor(Color.WHITE)
        self.input.setHintTextColor(Color.parseColor("#99FFFFFF"))
        self.input.setSingleLine(True)
        self.input.setTextSize(15.0)
        self.input.setPadding(dp(16), dp(10), dp(16), dp(10))
        self.input.setBackground(self.shape("#33FFFFFF", dp(22)))
        say.addView(self.input, LinearLayout.LayoutParams(0, -2, 1.0))
        send = self.round_btn("➤", ACCENT, 44, self.send_input, 17.0)
        sl = LinearLayout.LayoutParams(dp(44), dp(44))
        sl.leftMargin = dp(8)
        say.addView(send, sl)
        sylp = LinearLayout.LayoutParams(-1, -2)
        sylp.topMargin = dp(12)
        self.bottom.addView(say, sylp)

        self.root.addView(self.bottom, FrameLayout.LayoutParams(-1, -2, Gravity.BOTTOM))

        Prepared, Completed, Failed = L["Prepared"], L["Completed"], L["Failed"]
        self.vv.setOnPreparedListener(Prepared(lambda mp: self.p.safe(lambda: self.on_prepared(mp))))
        self.vv.setOnCompletionListener(Completed(lambda mp: self.p.safe(lambda: self.p.on_completed())))
        self.vv.setOnErrorListener(Failed(lambda w, e: self.p.safe(lambda: self.on_error(w, e))))

    def text(self, s, size=14.0, bold=False):
        t = self.TV(self.act)
        t.setText(s)
        t.setTextColor(self.Color.WHITE)
        t.setTextSize(size)
        if bold:
            t.setTypeface(self.Typeface.DEFAULT_BOLD)
        return t

    def shape(self, color, radius, oval=False):
        d = self.GD()
        d.setColor(self.Color.parseColor(color))
        if oval:
            d.setShape(self.GD.OVAL)
        else:
            d.setCornerRadius(float(radius))
        return d

    def grad(self, top):
        from java import jarray, jint
        colors = jarray(jint)([self.Color.parseColor("#D9000000"), self.Color.parseColor("#00000000")])
        orient = self.GD.Orientation.TOP_BOTTOM if top else self.GD.Orientation.BOTTOM_TOP
        return self.GD(orient, colors)

    def round_btn(self, label, color, size, fn, ts=15.0):
        b = self.text(label, ts, True)
        b.setGravity(self.Gravity.CENTER)
        b.setBackground(self.shape(color, 0, oval=True))
        b.setOnClickListener(OnClickListener(lambda v: self.p.safe(fn)))
        return b

    def pill(self, label, color, fn):
        dp = self.dp
        b = self.text(label, 16.0, True)
        b.setGravity(self.Gravity.CENTER)
        b.setPadding(dp(24), dp(12), dp(24), dp(13))
        b.setBackground(self.shape(color, dp(26)))
        b.setOnClickListener(OnClickListener(lambda v: self.p.safe(fn)))
        return b

    def head(self, user, name, dot, crown):
        dp = self.dp
        box = self.FL(self.act)
        box.setBackground(self.shape("#FFFFFF", 0, oval=True))
        box.setPadding(dp(2), dp(2), dp(2), dp(2))
        pic = None
        try:
            if user is not None:
                from org.telegram.ui.Components import BackupImageView, AvatarDrawable
                pic = BackupImageView(self.act)
                pic.setRoundRadius(dp(15))
                pic.setForUserOrChat(user, AvatarDrawable(user))
        except Exception as e:
            self.p.err(f"аватарка: {e}")
            pic = None
        if pic is None:
            pic = self.text((name or "?")[:1].upper(), 14.0, True)
            pic.setGravity(self.Gravity.CENTER)
            pic.setBackground(self.shape(ACCENT, 0, oval=True))
        box.addView(pic, self.FL.LayoutParams(-1, -1))
        d = self.TV(self.act)
        d.setBackground(self.shape(dot, 0, oval=True))
        box.addView(d, self.FL.LayoutParams(dp(10), dp(10), self.Gravity.BOTTOM | self.Gravity.END))
        if crown:
            box.addView(self.text("👑", 10.0), self.FL.LayoutParams(-2, -2, self.Gravity.TOP | self.Gravity.END))
        return box

    # ---------- загрузка видео ----------

    def load(self):
        path = self.p.local_path(self.mo)
        if path:
            self.open_file(path)
            return
        self.big.setText("⏬")
        self.info.setText("Загружаю видео…")
        self.p.download(self.mo)
        self.poll_download()

    def poll_download(self):
        if not self.alive:
            return
        path = self.p.local_path(self.mo)
        if path:
            self.open_file(path)
            return
        pc = self.p.download_percent(self.mo)
        self.info.setText(f"Загружаю видео… {pc}%" if pc else "Загружаю видео…")
        self.p.report_progress(pc)
        run_on_ui_thread(self.poll_download, 500)

    def open_file(self, path):
        self.local_path = path
        self.big.setText("")
        self.info.setText("Готовлю плеер…")
        self.vv.setVideoPath(path)

    def on_prepared(self, mp):
        self.mp = mp
        self.prepared = True
        self.duration = int(mp.getDuration())
        self.time_all.setText(fmt_time(self.duration))
        try:
            mp.setLooping(False)
        except Exception:
            pass
        self.vv.seekTo(0)
        self.p.on_player_ready()

    def on_error(self, what, extra):
        self.p.err(f"плеер: ошибка {what}/{extra}")
        self.big.setText("⚠️")
        self.info.setText("Это видео не открывается на устройстве")

    # ---------- управление ----------

    def position(self):
        try:
            return int(self.vv.getCurrentPosition()) if self.prepared else 0
        except Exception:
            return 0

    def playing(self):
        try:
            return bool(self.vv.isPlaying())
        except Exception:
            return False

    def seek_to(self, ms):
        if not self.prepared:
            return
        ms = max(0, min(int(ms), max(0, self.duration - 300)))
        try:
            if self.mp is not None:
                self.mp.seekTo(ms, 3)  # SEEK_CLOSEST — точно в нужный кадр
            else:
                self.vv.seekTo(ms)
        except Exception:
            self.vv.seekTo(ms)
        self.seek_block_until = time.time() + SEEK_COOLDOWN

    def play(self):
        if self.prepared and not self.playing():
            self.vv.start()

    def pause(self):
        if self.prepared and self.playing():
            self.vv.pause()

    def set_speed(self, x):
        x = round(float(x), 3)
        if abs(x - self.speed) < 0.001 or self.mp is None or not self.playing():
            return
        try:
            params = self.mp.getPlaybackParams()
            params.setSpeed(x)
            self.mp.setPlaybackParams(params)
            self.speed = x
        except Exception as e:
            self.p.err(f"скорость: {e}")

    # ---------- ползунок ----------

    def on_seek_change(self, progress, from_user):
        if from_user and self.duration:
            self.time_cur.setText(fmt_time(self.duration * progress / 1000))

    def on_seek_start(self):
        self.dragging = True

    def on_seek_stop(self, progress):
        self.dragging = False
        if self.p.is_host() and self.duration:
            self.p.host_seek(int(self.duration * progress / 1000))

    # ---------- цикл ----------

    def tick(self):
        if not self.alive:
            return
        try:
            self.p.on_tick(self)
            if self.prepared and not self.dragging:
                pos = self.position()
                self.time_cur.setText(fmt_time(pos))
                if self.duration:
                    self.seek.setProgress(int(pos * 1000 / self.duration))
            if self.btn_play is not None:
                self.btn_play.setText("⏸" if self.playing() else "▶")
            self.refresh_faces()
        except Exception as e:
            self.p.err(f"tick: {e}")
        run_on_ui_thread(self.tick, TICK_MS)

    def refresh_faces(self):
        people = self.p.lobby_people()
        sig = tuple((n, c, cr) for _, n, c, cr in people)
        if sig == self.heads_sig:
            return
        self.heads_sig = sig
        dp = self.dp
        self.faces.removeAllViews()
        for i, (user, name, dot, crown) in enumerate(people[:6]):
            lp = self.LL.LayoutParams(dp(32), dp(32))
            if i:
                lp.leftMargin = -dp(8)
            self.faces.addView(self.head(user, name, dot, crown), lp)
        if len(people) > 6:
            more = self.text(f"+{len(people) - 6}", 12.0, True)
            ml = self.LL.LayoutParams(-2, -2)
            ml.leftMargin = dp(4)
            self.faces.addView(more, ml)

    def set_state(self, big, info, show_start=False):
        self.big.setText(big or "")
        self.info.setText(info or "")
        self.center.setVisibility(0 if (big or info or show_start) else 8)
        self.start_btn.setVisibility(0 if show_start else 8)

    def set_titles(self, title, subtitle):
        self.title.setText(title)
        self.subtitle.setText(subtitle)

    def toggle_controls(self):
        self.controls_shown = not self.controls_shown
        a = 1.0 if self.controls_shown else 0.0
        for v in (self.top, self.bottom):
            v.setVisibility(0)
            v.animate().alpha(a).setDuration(200).start()

        def hide():
            if not self.controls_shown:
                self.top.setVisibility(4)
                self.bottom.setVisibility(4)
        if not self.controls_shown:
            run_on_ui_thread(hide, 220)

    def rotate(self):
        try:
            cur = self.act.getRequestedOrientation()
            self.act.setRequestedOrientation(-1 if cur == 6 else 6)  # SENSOR_LANDSCAPE ↔ как было
        except Exception as e:
            self.p.err(f"поворот: {e}")

    # ---------- сообщения ----------

    def send_input(self):
        t = str(self.input.getText()).strip()
        if t:
            self.input.setText("")
            self.p.say(t)

    def bubble(self, who, text, mine=False):
        if not self.alive:
            return
        dp = self.dp
        t = self.text(f"{who}: {text}", 14.0)
        t.setPadding(dp(12), dp(7), dp(12), dp(8))
        t.setBackground(self.shape(ACCENT if mine else PANEL, dp(16)))
        lp = self.LL.LayoutParams(-2, -2)
        lp.topMargin = dp(6)
        self.feed.addView(t, lp)
        self.bubbles.append(t)
        while len(self.bubbles) > 4:
            self.feed.removeView(self.bubbles.pop(0))

        def fade():
            if t in self.bubbles:
                self.bubbles.remove(t)
                try:
                    self.feed.removeView(t)
                except Exception:
                    pass
        run_on_ui_thread(fade, 8000)

    # ---------- закрытие ----------

    def close(self):
        if not self.alive:
            return
        self.alive = False
        try:
            self.vv.stopPlayback()
        except Exception:
            pass
        try:
            self.dialog.dismiss()
        except Exception:
            pass

    def on_dismissed(self):
        self.alive = False
        try:
            self.act.setRequestedOrientation(self.prev_orientation)
        except Exception:
            pass
        self.p.on_player_closed(self)


# ---------------- плагин ----------------

class WtogetherPlugin(BasePlugin):

    def on_plugin_load(self):
        # host:  {"role": "host",  "doc", "mo", "guests": {did: {"stage", "pc", "seen"}}, "started"}
        # guest: {"role": "guest", "doc", "mo", "host", "stage", "roster"}
        self.session = None
        self.player = None
        self.remote = None          # последнее состояние ведущего (у зрителя)
        self.go = None              # запланированный старт (у зрителя)
        self.offset = 0             # часы ведущего минус мои часы, мс
        self.best_rtt = None
        self.last_host_msg = 0
        self.invites = {}           # (host did, doc) -> id видео в моём чате
        self.talk = []
        self.seen = set()
        self.errors = []
        self.stats = {"sent": 0, "send_err": 0, "recv": 0, "last_recv": 0}
        self.to_delete = []
        self.last_prog = -1
        self.last_beat = 0.0
        self.last_ping = 0.0
        self.nudging = False
        self.rtts = []              # последние замеры (rtt, сдвиг)
        self.running = True

        self.add_hook("TL_updateNewMessage")
        self.add_hook("TL_updateShortMessage")
        try:
            NewMessages.plugin = self
            self.nc_delegate = NewMessages()
            get_notification_center().addObserver(self.nc_delegate, NotificationCenter.didReceiveNewMessages)
        except Exception as e:
            self.nc_delegate = None
            self.err(f"NotificationCenter: {e}")

        self.add_menu_item(MenuItemData(menu_type=MenuItemType.MESSAGE_CONTEXT_MENU,
                                        text="🎬 Смотреть вместе", on_click=self.on_watch_click))
        self.add_menu_item(MenuItemData(menu_type=MenuItemType.CHAT_ACTION_MENU,
                                        text="🎬 Wtogether", on_click=lambda ctx: self.open_panel()))
        threading.Timer(DELETE_EVERY, self.flush_deletes).start()
        self.logger.info("Wtogether 2.0 загружен")

    def on_plugin_unload(self):
        self.running = False
        try:
            if self.nc_delegate is not None:
                get_notification_center().removeObserver(self.nc_delegate, NotificationCenter.didReceiveNewMessages)
        except Exception:
            pass
        if self.player is not None:
            run_on_ui_thread(self.player.close)

    # ---------- общее ----------

    def err(self, text):
        self.logger.error(str(text))
        self.errors.append(time.strftime("%H:%M:%S ") + str(text))
        self.errors = self.errors[-20:]

    def safe(self, fn):
        try:
            fn()
        except Exception as e:
            self.err(f"действие: {e}")
            BulletinHelper.show_error("Ошибка — подробности в «Проверка работы»")

    def is_host(self):
        return bool(self.session) and self.session["role"] == "host"

    def is_guest(self):
        return bool(self.session) and self.session["role"] == "guest"

    def peers(self):
        if self.is_host():
            return list(self.session["guests"].keys())
        if self.is_guest():
            return [self.session["host"]]
        return []

    def room_now(self):
        return now_ms() + (self.offset if self.is_guest() else 0)

    def activity(self):
        if self.player is not None and self.player.alive:
            return self.player.act
        frag = get_last_fragment()
        return frag.getParentActivity() if frag else None

    def notify(self, text):
        if self.player is not None and self.player.alive:
            self.player.bubble("Wtogether", text)
        elif self.get_setting("notify", True):
            BulletinHelper.show_info(text)

    # ---------- пользователи ----------

    def me_user(self):
        try:
            from org.telegram.messenger import UserConfig
            return UserConfig.getInstance(UserConfig.selectedAccount).getCurrentUser()
        except Exception:
            return None

    def my_uid(self):
        try:
            from org.telegram.messenger import UserConfig
            return int(UserConfig.getInstance(UserConfig.selectedAccount).getClientUserId())
        except Exception:
            return 0

    def my_name(self):
        u = self.me_user()
        return u.first_name if u is not None and u.first_name else "Я"

    def user(self, did):
        try:
            return get_messages_controller().getUser(Long(did))
        except Exception:
            return None

    def name(self, did):
        u = self.user(did)
        return u.first_name if u is not None and u.first_name else "друг"

    def host_name(self):
        return self.name(self.session["host"]) if self.is_guest() else self.my_name()

    STAGE_DOT = {"ready": ONLINE, "watching": ONLINE, "loading": WAITING, "joined": WAITING,
                 "invited": OFFLINE}

    def lobby_people(self):
        if not self.session:
            return []
        if self.is_host():
            out = [(self.me_user(), self.my_name(), ONLINE, True)]
            for did, g in self.session["guests"].items():
                out.append((self.user(did), self.name(did), self.STAGE_DOT.get(g["stage"], OFFLINE), False))
            return out
        out = [(self.user(self.session["host"]), self.host_name(),
                ONLINE if now_ms() - self.last_host_msg < 30000 else OFFLINE, True)]
        me = self.my_uid()
        for r in self.session.get("roster") or []:
            uid = int(r.get("u") or 0)
            if uid and uid != me:
                out.append((self.user(uid), r.get("n") or "?", self.STAGE_DOT.get(r.get("s"), OFFLINE), False))
        out.append((self.me_user(), self.my_name(), ONLINE, False))
        return out

    # ---------- видеофайл ----------

    def doc_of(self, mo):
        try:
            d = mo.getDocument()
            return int(d.id) if d is not None else 0
        except Exception:
            return 0

    def local_path(self, mo):
        from java.io import File
        try:
            ap = mo.messageOwner.attachPath
            if ap and File(ap).exists() and File(ap).length() > 0:
                return str(ap)
        except Exception:
            pass
        try:
            f = get_file_loader().getPathToMessage(mo.messageOwner)
            if f is not None and f.exists() and f.length() > 0:
                return str(f.getAbsolutePath())
        except Exception as e:
            self.err(f"путь к файлу: {e}")
        return None

    def download(self, mo):
        try:
            get_file_loader().loadFile(mo.getDocument(), mo, 3, 0)
        except Exception as e:
            self.err(f"загрузка: {e}")

    def download_percent(self, mo):
        try:
            from java.io import File
            from org.telegram.messenger import FileLoader
            doc = mo.getDocument()
            name = FileLoader.getAttachFileName(doc)
            tmp = File(get_file_loader().getDirectory(4), name + ".temp")
            if tmp.exists() and doc.size > 0:
                return max(0, min(99, int(tmp.length() * 100 / doc.size)))
        except Exception:
            pass
        return 0

    def report_progress(self, pc):
        if self.is_guest() and pc // 20 != self.last_prog // 20:
            self.last_prog = pc
            self.send({"t": "prog", "pc": pc})

    # ---------- начало ----------

    def on_watch_click(self, context):
        self.safe(lambda: self.watch_message(context.get("message")))

    def watch_message(self, mo):
        if mo is None or not mo.isVideo():
            BulletinHelper.show_error("Выбери сообщение с видео")
            return
        did = int(mo.getDialogId())
        if did <= 0 or did == self.my_uid():
            BulletinHelper.show_error("Зови из личного чата с другом")
            return
        doc = self.doc_of(mo)
        if (did, doc) in self.invites and not self.is_host():
            self.join(did, doc, mo)  # видео из приглашения — входим зрителем
            return
        if self.is_guest():
            self.confirm("Ты сейчас зритель", f"Выйти из просмотра у {self.host_name()} и начать свой?",
                         "Начать свой", lambda: (self.end(), self.watch_message(mo)))
            return
        if self.is_host() and self.session["doc"] != doc:
            self.confirm("Идёт другой просмотр", "Закончить текущий и начать с этим видео?",
                         "Начать", lambda: (self.end(), self.watch_message(mo)))
            return
        if not self.session:
            self.session = {"role": "host", "doc": doc, "mo": mo, "guests": {}, "started": False}
            self.remote = None
            self.talk = []
        g = self.session["guests"]
        if did not in g:
            if len(g) >= MAX_GUESTS:
                BulletinHelper.show_error(f"Уже {MAX_GUESTS} зрителей")
                return
            g[did] = {"stage": "invited", "pc": 0, "seen": 0}
            text = (f"🎬 {self.my_name()} зовёт смотреть это видео вместе!\n"
                    "Нажми «Смотреть» во всплывшем окне — откроется общий плеер.\n"
                    "Нужен плагин Wtogether для exteraGram." + zw_encode({"t": "invite", "d": doc}))
            try:
                send_text(did, text, replyToMsg=mo)
            except Exception:
                send_text(did, text)
            BulletinHelper.show_success(f"👑 Приглашение отправлено {self.name(did)}")
        self.open_player(mo)

    def open_player(self, mo):
        if self.player is not None and self.player.alive:
            return
        try:
            self.player = Player(self, mo)
            self.update_ui()
        except Exception as e:
            self.player = None
            self.err(f"открыть плеер: {e}")
            BulletinHelper.show_error("Не удалось открыть плеер — см. «Проверка работы»")

    def join(self, host, doc, mo):
        if self.session and not (self.is_guest() and self.session["host"] == host):
            self.end()
        self.session = {"role": "guest", "doc": doc, "mo": mo, "host": host, "stage": "joined", "roster": []}
        self.remote = None
        self.go = None
        self.talk = []
        self.offset = 0
        self.best_rtt = None
        self.rtts = []
        self.nudging = False
        self.last_ping = time.time()
        self.last_prog = -1
        self.send({"t": "join"})
        for i in range(3):
            threading.Timer(0.3 + i * 1.2, lambda: self.send({"t": "ping", "a": now_ms()})).start()
        run_on_ui_thread(lambda: self.open_player(mo))

    def join_from_invite(self, host, doc, reply_id):
        """Находим видео из приглашения в своём чате и открываем плеер."""
        if not reply_id:
            BulletinHelper.show_info("Долгое нажатие на видео над приглашением → Плагины → «Смотреть вместе»")
            return
        try:
            req = TLRPC.TL_messages_getMessages()
            iid = TLRPC.TL_inputMessageID()
            iid.id = int(reply_id)
            req.id.add(iid)

            def done(resp, error):
                try:
                    if error is not None or resp is None or resp.messages.size() == 0:
                        raise RuntimeError(getattr(error, "text", "нет сообщения"))
                    from org.telegram.messenger import UserConfig
                    mo = MessageObject(UserConfig.selectedAccount, resp.messages.get(0), False, False)
                    run_on_ui_thread(lambda: self.safe(lambda: self.join(host, doc, mo)))
                except Exception as e:
                    self.err(f"видео из приглашения: {e}")
                    BulletinHelper.show_info("Долгое нажатие на видео над приглашением → Плагины → «Смотреть вместе»")
            send_request(req, done)
        except Exception as e:
            self.err(f"getMessages: {e}")

    # ---------- ведущий ----------

    def host_start(self):
        if not self.is_host() or self.player is None or not self.player.prepared:
            return
        pos = self.player.position()
        at = now_ms() + COUNTDOWN_MS
        self.session["started"] = True
        self.send({"t": "go", "pos": pos, "at": at, "r": self.player.speed or 1.0})
        self.player.countdown_at = at
        self.update_ui()

    def host_state(self):
        pl = self.player
        return {"t": "st", "p": pl.playing(), "pos": pl.position(), "r": pl.speed or 1.0, "ts": now_ms()}

    def broadcast_state(self, to=None):
        if self.is_host() and self.player is not None and self.player.prepared:
            self.send(self.host_state(), to=to)
            self.last_beat = time.time()

    def host_toggle(self):
        pl = self.player
        if not self.is_host() or pl is None or not pl.prepared:
            return
        if not self.session["started"]:
            self.host_start()
            return
        if pl.playing():
            pl.pause()
        else:
            pl.play()
        self.broadcast_state()

    def host_skip(self, delta):
        pl = self.player
        if self.is_host() and pl is not None and pl.prepared:
            pl.seek_to(pl.position() + delta)
            run_on_ui_thread(self.broadcast_state, 250)

    def host_seek(self, ms):
        pl = self.player
        if self.is_host() and pl is not None and pl.prepared:
            pl.seek_to(ms)
            run_on_ui_thread(self.broadcast_state, 250)

    def host_speed(self):
        pl = self.player
        if not self.is_host() or pl is None:
            return
        cur = pl.speed or 1.0
        nxt = SPEEDS[(SPEEDS.index(cur) + 1) % len(SPEEDS)] if cur in SPEEDS else 1.0
        if not pl.playing():
            BulletinHelper.show_info("Скорость меняется во время воспроизведения")
            return
        pl.set_speed(nxt)
        if pl.btn_speed is not None:
            pl.btn_speed.setText(f"{nxt:g}×")
        self.broadcast_state()

    def on_completed(self):
        if self.is_host():
            self.broadcast_state()
            self.notify("Видео закончилось")

    def send_roster(self):
        if not self.is_host():
            return
        m = [{"u": d, "n": self.name(d), "s": g["stage"]} for d, g in self.session["guests"].items()
             if g["stage"] != "invited"]
        self.send({"t": "roster", "m": m})

    # ---------- зритель ----------

    def catch_up(self):
        if self.is_guest():
            self.send({"t": "ask"})
            if self.player is not None:
                self.player.seek_block_until = 0
            BulletinHelper.show_info("Догоняю ведущего…")

    def on_player_ready(self):
        if self.is_guest():
            self.session["stage"] = "ready"
            self.send({"t": "ready"})
        self.update_ui()

    # ---------- цикл плеера ----------

    def on_tick(self, pl):
        if not self.session:
            return
        if self.is_host():
            if pl.countdown_at:
                left = pl.countdown_at - now_ms()
                if left <= 0:
                    pl.countdown_at = 0
                    pl.play()
                    self.broadcast_state()
                    self.update_ui()
                else:
                    pl.set_state(str(left // 1000 + 1), "Старт для всех", False)
            elif pl.playing() and time.time() - getattr(self, "last_beat", 0) > HEARTBEAT_S:
                self.broadcast_state()
            self.update_titles()
            return

        # зритель
        if not pl.prepared:
            self.update_titles()
            return
        if self.go:
            left = self.go["at"] - self.room_now()
            if left > 0:
                pl.set_state(str(left // 1000 + 1), "Старт для всех", False)
                if abs(pl.position() - self.go["pos"]) > SMALL_DRIFT and time.time() > pl.seek_block_until:
                    pl.seek_to(self.go["pos"])
                self.update_titles()
                return
            self.remote = {"p": True, "pos": self.go["pos"], "r": self.go["r"], "ts": self.go["at"]}
            self.go = None
            self.update_ui()
        st = self.remote
        if st is None:
            pl.pause()
            self.update_titles()
            return
        if time.time() - self.last_ping > PING_EVERY:
            self.last_ping = time.time()
            self.send({"t": "ping", "a": now_ms()})
        play, seek, speed, self.nudging = plan_correction(st, self.room_now(), pl.position(),
                                                          pl.playing(), self.nudging)
        if seek is not None and time.time() > pl.seek_block_until:
            pl.seek_to(seek)
        if play:
            pl.play()
            pl.set_speed(speed)
        else:
            pl.pause()
        self.update_titles()

    def update_titles(self):
        pl = self.player
        if pl is None or not pl.alive or not self.session:
            return
        if self.is_host():
            g = self.session["guests"]
            ready = sum(1 for x in g.values() if x["stage"] in ("ready", "watching"))
            pl.set_titles("👑 Ты ведёшь", f"готовы {ready} из {len(g)}" if g else "ждём зрителей")
        else:
            ago = (now_ms() - self.last_host_msg) // 1000 if self.last_host_msg else None
            link = "на связи" if ago is not None and ago < 30 else ("нет связи" if ago is not None else "подключаюсь")
            pl.set_titles(f"👑 Ведёт {self.host_name()}", link)

    def update_ui(self):
        pl = self.player
        if pl is None or not pl.alive or not self.session:
            return
        if not pl.prepared:
            return
        if self.is_host():
            if not self.session["started"]:
                lines = []
                for did, g in self.session["guests"].items():
                    st = {"invited": "не ответил(а)", "joined": "подключается", "ready": "готов(а)",
                          "watching": "готов(а)",
                          "loading": f"загружает {g.get('pc', 0)}%"}.get(g["stage"], g["stage"])
                    lines.append(f"{self.name(did)} — {st}")
                pl.set_state("👥", "\n".join(lines) or "Ждём зрителей…", True)
            elif not pl.countdown_at:
                pl.set_state("", "", False)
        else:
            if self.go:
                return
            if self.remote is None:
                pl.set_state("⏳", f"Ждём, когда {self.host_name()} начнёт", False)
            else:
                pl.set_state("", "", False)
        self.update_titles()

    # ---------- общение ----------

    def say(self, text):
        text = text[:300]
        at = self.player.position() if self.player is not None else 0
        self.talk.append((at, self.my_name(), text))
        self.send({"t": "msg", "x": text, "at": at, "n": self.my_name(), "u": self.my_uid()})
        if self.player is not None:
            self.player.bubble("Я", text, mine=True)

    def start_call(self):
        dids = self.peers()
        if not dids:
            return
        if len(dids) == 1:
            self.call(dids[0])
            return
        act = self.activity()
        b = AlertDialogBuilder(act)
        b.set_title("📞 Кому позвонить?")
        b.set_items([self.name(d) for d in dids], lambda bb, i: (bb.dismiss(), self.call(dids[int(i)])))
        b.set_negative_button("Отмена", lambda bb, w: bb.dismiss())
        b.show()

    def call(self, did):
        try:
            from org.telegram.ui.Components.voip import VoIPHelper
            from org.telegram.messenger import AccountInstance, UserConfig
            mc = get_messages_controller()
            full = mc.getUserFull(Long(did))
            VoIPHelper.startCall(mc.getUser(Long(did)), False,
                                 bool(full is not None and full.video_calls_available),
                                 self.activity(), full, AccountInstance.getInstance(UserConfig.selectedAccount))
        except Exception as e:
            self.err(f"звонок: {e}")
            BulletinHelper.show_error("Не удалось начать звонок")

    def send_talk(self):
        if not self.talk or not self.peers():
            return
        lines = [f"{fmt_time(at)} {who}: {t}" for at, who, t in sorted(self.talk, key=lambda x: x[0])]
        body = "🎬 Обсуждали видео вместе:\n\n" + "\n".join(lines)
        for did in self.peers():
            send_text(did, body[:4000])
        self.talk = []

    # ---------- завершение ----------

    def confirm(self, title, message, yes, fn):
        def ui():
            act = self.activity()
            if act is None:
                return
            b = AlertDialogBuilder(act)
            b.set_title(title)
            b.set_message(message)
            b.set_positive_button(yes, lambda bb, w: (bb.dismiss(), self.safe(fn)))
            b.set_negative_button("Отмена", lambda bb, w: bb.dismiss())
            b.show()
        run_on_ui_thread(ui)

    def ask_close(self):
        if not self.session:
            if self.player is not None:
                self.player.close()
            return
        if self.is_host():
            self.confirm("Закончить просмотр?", "Плеер закроется у всех зрителей.", "Закончить", self.end)
        else:
            self.confirm("Выйти из просмотра?", f"{self.host_name()} и остальные продолжат без тебя.",
                         "Выйти", self.end)

    def end(self):
        if self.is_host():
            if self.talk and self.get_setting("send_talk", True):
                self.send_talk()
            self.send({"t": "stop"})
        elif self.is_guest():
            self.send({"t": "leave"})
        self.session = None
        self.remote = None
        self.go = None
        pl, self.player = self.player, None   # сразу отвязываем, чтобы можно было открыть новый
        if pl is not None:
            run_on_ui_thread(pl.close)

    def on_player_closed(self, pl):
        if self.player is not pl:
            return            # старый плеер, уже отвязан
        self.player = None
        if self.session:      # закрыли не через «Закончить» — считаем, что вышли
            self.end()

    # ---------- панель и настройки ----------

    def status_text(self):
        if not self.session:
            return "Совместный просмотр не идёт.\n\nДолгое нажатие на видео в личке → Плагины → «🎬 Смотреть вместе»."
        if self.is_host():
            lines = ["👑 Ты ведёшь просмотр", ""]
            for did, g in self.session["guests"].items():
                lines.append(f"{self.name(did)}: {g['stage']}" + (f" {g['pc']}%" if g["stage"] == "loading" else ""))
            return "\n".join(lines)
        return f"👑 Ведёт {self.host_name()}\nУправлять видео может только ведущий."

    def open_panel(self):
        def ui():
            act = self.activity()
            if act is None:
                return
            b = AlertDialogBuilder(act)
            b.set_title("🎬 Wtogether")
            b.set_message(self.status_text())
            if self.session and self.player is None and self.session.get("mo") is not None:
                b.set_positive_button("Открыть плеер",
                                      lambda bb, w: (bb.dismiss(), self.open_player(self.session["mo"])))
            if self.session:
                b.set_negative_button("Закончить" if self.is_host() else "Выйти",
                                      lambda bb, w: (bb.dismiss(), self.safe(self.end)))
            b.set_neutral_button("Закрыть", lambda bb, w: bb.dismiss())
            b.show()
        run_on_ui_thread(ui)

    def create_settings(self):
        return [
            Header(text="Wtogether"),
            Text(text="Статус", subtext=self.status_text().replace("\n", " "), icon="msg_info",
                 on_click=lambda v: self.open_panel()),
            Divider(),
            Header(text="Настройки"),
            Switch(key="ask_invite", text="Спрашивать перед подключением", default=True,
                   subtext="Окно «Смотреть / Отказаться», когда зовут смотреть"),
            Switch(key="send_talk", text="Отправлять обсуждение в чат", default=True,
                   subtext="Когда ведущий заканчивает, сообщения из плеера уходят в чаты"),
            Switch(key="notify", text="Уведомления вне плеера", default=True),
            Divider(),
            Header(text="Как пользоваться"),
            Text(text="1. Позови", subtext="Долгое нажатие на видео в личке → Плагины → «Смотреть вместе»"),
            Text(text="2. Подождите загрузку", subtext="В плеере видно, кто готов. Ведущий жмёт «Начать для всех»"),
            Text(text="3. Смотрите", subtext="Управляет только ведущий 👑, у остальных всё повторяется само"),
            Divider(),
            Text(text="🛠 Проверка работы", subtext="Если что-то не так — нажми и пришли текст",
                 on_click=lambda v: self.diagnostics()),
            Divider(text="Плагин нужен у всех участников"),
        ]

    def diagnostics(self):
        def has(cls):
            try:
                from hook_utils import find_class
                return "есть" if find_class(cls) else "НЕТ"
            except Exception:
                return "?"
        s = self.stats
        ago = (now_ms() - s["last_recv"]) // 1000 if s["last_recv"] else None
        lines = [f"Версия {__version__}",
                 f"Плеер Android (VideoView): {has('android.widget.VideoView')}",
                 f"Загрузчик файлов: {'есть' if get_file_loader() is not None else 'НЕТ'}",
                 f"Приём через NotificationCenter: {'да' if self.nc_delegate else 'нет'}",
                 f"Звонки: {has('org.telegram.ui.Components.voip.VoIPHelper')}",
                 f"Отправлено команд: {s['sent']}, ошибок отправки: {s['send_err']}",
                 f"Получено команд: {s['recv']}" + (f", последняя {ago} с назад" if ago is not None else ""),
                 f"Лобби: {self.session['role'] if self.session else 'нет'}",
                 f"Сдвиг часов: {self.offset} мс" + (f", пинг {self.best_rtt} мс" if self.best_rtt else "")]
        if self.errors:
            lines += ["", "Ошибки:"] + self.errors[-10:]
        text = "\n".join(lines)

        def ui():
            act = self.activity()
            if act is None:
                return
            b = AlertDialogBuilder(act)
            b.set_title("🛠 Проверка Wtogether")
            b.set_message(text)
            b.set_positive_button("Скопировать", lambda bb, w: (bb.dismiss(), copy_to_clipboard(text)))
            b.set_negative_button("Закрыть", lambda bb, w: bb.dismiss())
            b.show()
        run_on_ui_thread(ui)

    # ---------- отправка ----------

    def human(self, c):
        t = c.get("t")
        if t == "st":
            return ("▶️ " if c["p"] else "⏸ ") + fmt_time(c["pos"])
        if t == "msg":
            return "💬 " + c.get("x", "")
        return {"go": "▶️ старт", "join": "подключаюсь", "ready": "готов(а)", "prog": "загружаю",
                "ping": "связь", "pong": "связь", "roster": "участники", "ask": "синхронизация",
                "leave": "вышел(ла)", "stop": "просмотр закончен", "decline": "отказ"}.get(t, t or "")

    def send(self, cmd, to=None):
        targets = [to] if to else self.peers()
        doc = cmd.get("d") or (self.session["doc"] if self.session else 0)
        for did in targets:
            c = dict(cmd)
            c["d"] = doc
            text = ("🎬 Wtogether: " + self.human(c) + "\n" + TAG +
                    json.dumps(c, separators=(",", ":"), ensure_ascii=False))
            try:
                req = TLRPC.TL_messages_sendMessage()
                req.peer = get_messages_controller().getInputPeer(Long(did))
                req.message = text
                req.random_id = random.getrandbits(62)
                req.no_webpage = True
                req.silent = True
                send_request(req, self.after_sent)
                self.stats["sent"] += 1
            except Exception as e:
                self.stats["send_err"] += 1
                self.err(f"отправка: {e}")

    def after_sent(self, resp, error):
        if error is not None or resp is None:
            self.stats["send_err"] += 1
            self.err(f"команда не ушла: {getattr(error, 'text', error)}")
            return
        try:
            if hasattr(resp, "updates") and resp.updates is not None:
                for i in range(resp.updates.size()):
                    u = resp.updates.get(i)
                    if u.getClass().getSimpleName() == "TL_updateMessageID":
                        self.to_delete.append(int(u.id))
            elif hasattr(resp, "id"):
                self.to_delete.append(int(resp.id))
        except Exception as e:
            self.err(f"after_sent: {e}")

    def flush_deletes(self):
        if not self.running:
            return
        ids, self.to_delete = self.to_delete[:100], self.to_delete[100:]
        if ids:
            try:
                req = TLRPC.TL_messages_deleteMessages()
                req.revoke = True
                for i in ids:
                    req.id.add(Integer(i))
                send_request(req, lambda r, e: e is not None and self.err(f"удаление: {getattr(e, 'text', e)}"))
            except Exception as e:
                self.err(f"удаление: {e}")
        threading.Timer(DELETE_EVERY, self.flush_deletes).start()

    def delete_local(self, did, mids):
        """Удаляем полученные служебные сообщения у себя (и на сервере)."""
        try:
            from java.util import ArrayList
            from hook_utils import find_class
            ids = ArrayList()
            for m in mids:
                ids.add(Integer(m))
            mc = get_messages_controller()
            cls = find_class("org.telegram.messenger.MessagesController")
            for m in cls.getDeclaredMethods():
                if str(m.getName()) != "deleteMessages":
                    continue
                types = [str(t.getName()) for t in m.getParameterTypes()]
                if len(types) < 5 or types[0] != "java.util.ArrayList":
                    continue
                if "long" not in types or "boolean" not in types:
                    continue
                args, used_list, used_long = [], False, False
                for t in types:
                    if t == "java.util.ArrayList":
                        args.append(None if used_list else ids)
                        used_list = True
                    elif t == "long":
                        args.append(Long(0 if used_long else did))   # первый long — id чата
                        used_long = True
                    elif t == "boolean":
                        args.append(Boolean(True))
                    elif t == "int":
                        args.append(Integer(0))
                    else:
                        args.append(None)
                m.invoke(mc, *args)
                return
        except Exception as e:
            self.err(f"удаление у себя: {e}")

    # ---------- приём ----------

    def on_update_hook(self, update_name, account, update):
        try:
            msg = getattr(update, "message", None)
            if msg is None or msg.out or not has_cmd(msg.message):
                return HookResult()
            reply = 0
            try:
                reply = int(msg.reply_to.reply_to_msg_id) if msg.reply_to is not None else 0
            except Exception:
                pass
            if self.incoming(int(MessageObject.getDialogId(msg)), int(msg.id), msg.message, reply):
                return HookResult(strategy=HookStrategy.CANCEL)
        except Exception as e:
            self.err(f"on_update_hook: {e}")
        return HookResult()

    def on_updates_hook(self, container_name, account, updates):
        try:
            if container_name != "TL_updateShortMessage" or updates.out or not has_cmd(updates.message):
                return HookResult()
            reply = 0
            try:
                reply = int(updates.reply_to.reply_to_msg_id) if updates.reply_to is not None else 0
            except Exception:
                pass
            if self.incoming(int(updates.user_id), int(updates.id), updates.message, reply):
                return HookResult(strategy=HookStrategy.CANCEL)
        except Exception as e:
            self.err(f"on_updates_hook: {e}")
        return HookResult()

    def on_new_messages(self, did, messages):
        hide = []
        for i in range(messages.size()):
            mo = messages.get(i)
            try:
                if mo.isOut():
                    continue
                text = str(mo.messageOwner.message or "")
                if not has_cmd(text):
                    continue
                reply = 0
                try:
                    reply = int(mo.getReplyMsgId())
                except Exception:
                    pass
                if self.incoming(did, int(mo.getId()), text, reply):
                    hide.append(int(mo.getId()))
            except Exception as e:
                self.err(f"new message: {e}")
        if hide:
            run_on_ui_thread(lambda: self.delete_local(did, hide))

    def incoming(self, did, mid, text, reply=0):
        """Разбирает команду в любом потоке, обрабатывает в главном. True — скрыть."""
        key = (did, mid)
        cmd = extract_cmd(text)
        if not cmd:
            return False
        hide = cmd.get("t") != "invite"
        if key in self.seen:
            return hide
        self.seen.add(key)
        if len(self.seen) > 1000:
            self.seen.clear()
        self.stats["recv"] += 1
        self.stats["last_recv"] = now_ms()
        run_on_ui_thread(lambda: self.safe(lambda: self.process(did, cmd, reply)))
        return hide

    def process(self, did, c, reply):
        t = c.get("t")
        doc = int(c.get("d") or 0)
        name = self.name(did)

        if t == "invite":
            self.invites[(did, doc)] = reply
            self.on_invite(did, doc, reply)
            return

        # --- я ведущий ---
        if self.is_host() and did in self.session["guests"] and doc == self.session["doc"]:
            g = self.session["guests"][did]
            g["seen"] = now_ms()
            if t == "join":
                g["stage"] = "joined"
                self.notify(f"✅ {name} подключается")
                self.send_roster()
            elif t == "prog":
                g["stage"] = "loading"
                g["pc"] = int(c.get("pc") or 0)
            elif t == "ready":
                g["stage"] = "ready"
                self.notify(f"🟢 {name} готов(а)")
                self.send_roster()
                if self.session["started"]:
                    self.broadcast_state(to=did)
            elif t == "ask":
                self.broadcast_state(to=did)
            elif t == "ping":
                self.send({"t": "pong", "a": c.get("a"), "b": now_ms()}, to=did)
            elif t in ("leave", "decline"):
                self.session["guests"].pop(did, None)
                self.notify(f"👋 {name} " + ("вышел(ла)" if t == "leave" else "отказался(ась)"))
                self.send_roster()
            elif t == "msg":
                x = str(c.get("x") or "")[:300]
                at = int(c.get("at") or 0)
                self.talk.append((at, name, x))
                if self.player is not None:
                    self.player.bubble(name, x)
                for other in self.peers():
                    if other != did:
                        self.send({"t": "msg", "x": x, "at": at, "n": name, "u": did}, to=other)
            self.update_ui()
            return

        # --- я зритель ---
        if self.is_guest() and did == self.session["host"]:
            self.last_host_msg = now_ms()
            if t == "pong":
                a, b = int(c.get("a") or 0), int(c.get("b") or 0)
                rtt = now_ms() - a
                if a and b and rtt >= 0:
                    # берём замер с самой короткой задержкой из последних — он точнее всего
                    self.rtts = (self.rtts + [(rtt, b + rtt // 2 - now_ms())])[-6:]
                    self.best_rtt, self.offset = min(self.rtts)
            elif t == "go" and doc == self.session["doc"]:
                self.go = {"pos": int(c.get("pos") or 0), "at": int(c.get("at") or 0), "r": float(c.get("r") or 1.0)}
                self.remote = None
            elif t == "st" and doc == self.session["doc"]:
                self.go = None
                prev = self.remote
                self.remote = {"p": bool(c.get("p")), "pos": int(c.get("pos") or 0),
                               "r": float(c.get("r") or 1.0), "ts": int(c.get("ts") or self.room_now())}
                if prev is not None and prev["p"] != self.remote["p"] and self.player is not None:
                    self.player.bubble("👑 " + name, self.human(c))
            elif t == "roster":
                self.session["roster"] = c.get("m") or []
            elif t == "msg":
                who = c.get("n") or name
                x = str(c.get("x") or "")[:300]
                self.talk.append((int(c.get("at") or 0), who, x))
                if self.player is not None:
                    self.player.bubble(who, x)
                else:
                    self.notify(f"💬 {who}: {x}")
            elif t == "stop":
                self.notify(f"⏹ {name} закончил(а) просмотр")
                self.session = None
                self.remote = None
                if self.player is not None:
                    self.player.close()
                return
            self.update_ui()

    def on_invite(self, host, doc, reply):
        name = self.name(host)

        def accept():
            self.join_from_invite(host, doc, reply)

        def decline():
            self.send({"t": "decline", "d": doc}, to=host)

        if not self.get_setting("ask_invite", True) and not self.session:
            accept()
            return
        act = self.activity()
        if act is None:
            BulletinHelper.show_info(f"🎬 {name} зовёт смотреть вместе")
            return
        b = AlertDialogBuilder(act)
        b.set_title(f"🎬 {name} зовёт смотреть вместе")
        b.set_message(f"{name} — ведущий 👑: он ставит паузу и перематывает, у тебя всё повторяется само.\n\n"
                      "Откроется общий плеер, видео загрузится, и вы начнёте одновременно.")
        b.set_positive_button("Смотреть", lambda bb, w: (bb.dismiss(), self.safe(accept)))
        b.set_negative_button("Отказаться", lambda bb, w: (bb.dismiss(), self.safe(decline)))
        b.set_neutral_button("Позже", lambda bb, w: bb.dismiss())
        b.show()
        try:
            b.make_button_red(AlertDialogBuilder.BUTTON_NEGATIVE)
        except Exception:
            pass
