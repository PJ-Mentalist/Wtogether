__icon__ = "exteraPlugins/1"
__category__ = ["media", "chats"]

TICK_MS = 300            # цикл плеера
HEARTBEAT_S = 3.0        # ведущий обновляет состояние во время воспроизведения
COUNTDOWN_MS = 3000      # отсчёт перед стартом
SEEK_COOLDOWN = 1.5      # с: после перемотки даём плееру устояться
PING_EVERY = 20.0        # с: зритель уточняет разницу часов
SKIP_MS = 10000
SPEEDS = [1.0, 1.25, 1.5, 2.0, 0.75]

ACCENT = "#3E8EF7"
DARK = "#99000000"
PANEL = "#CC0B0F14"
ONLINE = "#4CD964"
OFFLINE = "#8E8E93"
WAITING = "#FFB340"

# ===== PURE START — чистый Python без Android, проверяется тестами в plugin/tools =====
import json
import random
import socket
import ssl
import threading
import time

NS = "wtogether3"
CODE_ALPHABET = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789"   # без 0/O и 1/I
# Публичные бесплатные MQTT-брокеры. Код комнаты указывает, на каком брокере она живёт.
BROKERS = [
    ("broker.emqx.io", [(1883, False), (8883, True)]),
    ("broker.hivemq.com", [(1883, False), (8883, True)]),
    ("test.mosquitto.org", [(1883, False), (8886, True)]),
]
KEEPALIVE = 30
ZW0, ZW1, ZWM = "​", "‌", "⁣"

SMALL_DRIFT = 150        # мс: меньше — не трогаем
BIG_DRIFT = 2000         # мс: больше — перематываем, между — подстраиваем скорость
NUDGE = 0.08             # насколько ускоряем/замедляем при подстройке
NUDGE_DONE = 80          # мс: до какого расхождения подтягиваем, раз начали


def now_ms():
    return int(time.time() * 1000)


def fmt_time(ms):
    s = max(0, int(ms) // 1000)
    h, s = divmod(s, 3600)
    m, s = divmod(s, 60)
    return f"{h}:{m:02d}:{s:02d}" if h else f"{m}:{s:02d}"


def new_code(broker_index):
    """6 символов; первый кодирует брокер, чтобы все пришли на один и тот же."""
    n = len(BROKERS)
    first = [c for i, c in enumerate(CODE_ALPHABET) if i % n == broker_index]
    return random.choice(first) + "".join(random.choice(CODE_ALPHABET) for _ in range(5))


def normalize_code(text):
    """«k7p 4qd» → «K7P4QD». None, если это не код."""
    code = "".join(c for c in str(text or "").upper() if c.isalnum())
    return code if len(code) == 6 and all(c in CODE_ALPHABET for c in code) else None


def broker_of(code):
    return CODE_ALPHABET.index(code[0]) % len(BROKERS)


def zw_encode(obj):
    raw = json.dumps(obj, separators=(",", ":")).encode("utf-8")
    return ZWM + "".join(ZW1 if bit == "1" else ZW0 for b in raw for bit in f"{b:08b}") + ZWM


def zw_decode(text):
    if not text:
        return None
    i = text.find(ZWM)
    j = text.find(ZWM, i + 1) if i >= 0 else -1
    if i < 0 or j < 0:
        return None
    bits = "".join("1" if c == ZW1 else "0" for c in text[i + 1:j] if c in (ZW0, ZW1))
    if not bits or len(bits) % 8:
        return None
    try:
        return json.loads(bytes(int(bits[k:k + 8], 2) for k in range(0, len(bits), 8)).decode("utf-8"))
    except Exception:
        return None


def expected_pos(st, room_now):
    """Где сейчас должен быть ведущий по последнему состоянию."""
    if not st["p"]:
        return st["pos"]
    return st["pos"] + max(0, room_now - st["ts"]) * st["r"]


def plan_correction(st, room_now, cur, playing, nudging=False):
    """Что сделать зрителю, чтобы совпасть с ведущим.
    Возвращает (play, seek_to или None, speed, nudging)."""
    target = expected_pos(st, room_now)
    diff = cur - target
    if not st["p"] or room_now < st["ts"]:          # пауза или ещё идёт отсчёт
        return False, (int(target) if abs(diff) > SMALL_DRIFT else None), st["r"], False
    if not playing:                                 # запускаемся — встаём точно на место
        return True, (int(target) if abs(diff) > NUDGE_DONE else None), st["r"], False
    if abs(diff) > BIG_DRIFT:
        return True, int(target), st["r"], False
    if abs(diff) > SMALL_DRIFT or (nudging and abs(diff) > NUDGE_DONE):
        return True, None, st["r"] * (1 - NUDGE if diff > 0 else 1 + NUDGE), True
    return True, None, st["r"], False


# ---------- минимальный MQTT 3.1.1 клиент (QoS 0, retain, last will) ----------

def _enc_len(n):
    out = bytearray()
    while True:
        b = n % 128
        n //= 128
        out.append(b | (0x80 if n else 0))
        if not n:
            return bytes(out)


def _enc_str(s):
    b = s.encode("utf-8") if isinstance(s, str) else bytes(s)
    return len(b).to_bytes(2, "big") + b


def _packet(first, body):
    return bytes([first]) + _enc_len(len(body)) + body


class MqttClient:
    """Сам переподключается, переподписывается и вызывает on_connect после каждого подключения."""

    def __init__(self, on_message, on_connect=None, on_status=None, log=None):
        self.on_message = on_message
        self.on_connect = on_connect
        self.on_status = on_status or (lambda s: None)
        self.log = log or (lambda s: None)
        self.client_id = "wt3-" + "".join(random.choice("0123456789abcdef") for _ in range(12))
        self.endpoints = []
        self.will = None
        self.subs = []
        self.sock = None
        self.lock = threading.Lock()
        self.connected = False
        self.running = False
        self.thread = None
        self.pid = 1
        self.endpoint = None

    def configure(self, endpoints, will=None):
        self.endpoints = list(endpoints)
        self.will = will

    def start(self):
        self.running = True
        self.thread = threading.Thread(target=self._run, name="wtogether-mqtt", daemon=True)
        self.thread.start()

    def stop(self, graceful=True):
        self.running = False
        s = self.sock
        if s is not None:
            try:
                if graceful and self.connected:
                    self._send(b"\xe0\x00")      # DISCONNECT — брокер не шлёт «завещание»
            except Exception:
                pass
            try:
                s.close()
            except Exception:
                pass

    def subscribe(self, topic):
        if topic not in self.subs:
            self.subs.append(topic)
        if self.connected:
            self._subscribe(topic)

    def publish(self, topic, payload, retain=False):
        if isinstance(payload, (dict, list)):
            payload = json.dumps(payload, separators=(",", ":"), ensure_ascii=False)
        if isinstance(payload, str):
            payload = payload.encode("utf-8")
        if not self.connected:
            return False
        try:
            self._send(_packet(0x30 | (1 if retain else 0), _enc_str(topic) + payload))
            return True
        except Exception as e:
            self.log(f"publish: {e}")
            self._drop()
            return False

    # --- внутреннее ---

    def _send(self, data):
        with self.lock:
            self.sock.sendall(data)

    def _subscribe(self, topic):
        self.pid = self.pid % 65000 + 1
        body = self.pid.to_bytes(2, "big") + _enc_str(topic) + b"\x00"
        self._send(_packet(0x82, body))

    def _drop(self):
        self.connected = False
        try:
            if self.sock is not None:
                self.sock.close()
        except Exception:
            pass

    def _connect(self, host, port, tls):
        raw = socket.create_connection((host, port), timeout=8)
        if tls:
            ctx = ssl.create_default_context()
            raw = ctx.wrap_socket(raw, server_hostname=host)
        raw.settimeout(1.0)
        self.sock = raw
        flags = 0x02  # clean session
        payload = _enc_str(self.client_id)
        if self.will:
            topic, msg, retain = self.will
            flags |= 0x04 | (0x20 if retain else 0)
            payload += _enc_str(topic) + _enc_str(msg if isinstance(msg, (bytes, bytearray)) else
                                                   json.dumps(msg, separators=(",", ":")))
        body = _enc_str("MQTT") + bytes([4, flags]) + KEEPALIVE.to_bytes(2, "big") + payload
        self._send(_packet(0x10, body))
        deadline = time.time() + 8
        buf = bytearray()
        while len(buf) < 4:
            if time.time() > deadline:
                raise OSError("нет ответа брокера")
            try:
                chunk = raw.recv(4 - len(buf))
            except socket.timeout:
                continue
            if not chunk:
                raise OSError("брокер закрыл соединение")
            buf += chunk
        if buf[0] != 0x20 or buf[3] != 0:
            raise OSError(f"брокер отказал: {buf[3]}")

    def _run(self):
        attempt = 0
        while self.running:
            ok = False
            for host, port, tls in self.endpoints:
                if not self.running:
                    return
                try:
                    self.on_status("подключаюсь")
                    self._connect(host, port, tls)
                    self.connected = True
                    self.endpoint = f"{host}:{port}"
                    attempt = 0
                    for t in self.subs:
                        self._subscribe(t)
                    self.on_status("на связи")
                    if self.on_connect:
                        try:
                            self.on_connect()
                        except Exception as e:
                            self.log(f"on_connect: {e}")
                    self._loop()
                    ok = True
                except Exception as e:
                    self.log(f"{host}:{port} — {e}")
                finally:
                    self._drop()
                if not self.running:
                    return
                if ok:
                    break
            self.on_status("нет связи, переподключаюсь")
            attempt += 1
            time.sleep(min(10, 1 + attempt))

    def _loop(self):
        buf = bytearray()
        last_rx = last_tx = time.time()
        while self.running and self.connected:
            now = time.time()
            if now - last_tx > KEEPALIVE / 2:
                self._send(b"\xc0\x00")       # PINGREQ
                last_tx = now
            if now - last_rx > KEEPALIVE * 1.5:
                raise OSError("брокер молчит")
            try:
                chunk = self.sock.recv(4096)
            except socket.timeout:
                continue
            if not chunk:
                raise OSError("соединение закрыто")
            last_rx = time.time()
            buf += chunk
            while True:
                if len(buf) < 2:
                    break
                mult, length, i = 1, 0, 1
                while True:
                    if i >= len(buf):
                        length = None
                        break
                    b = buf[i]
                    length += (b & 0x7F) * mult
                    mult *= 128
                    i += 1
                    if not b & 0x80:
                        break
                if length is None or len(buf) < i + length:
                    break
                first, body = buf[0], bytes(buf[i:i + length])
                del buf[:i + length]
                if first >> 4 == 3:                      # PUBLISH
                    tl = int.from_bytes(body[:2], "big")
                    topic = body[2:2 + tl].decode("utf-8", "replace")
                    pos = 2 + tl + (2 if (first >> 1) & 3 else 0)
                    try:
                        self.on_message(topic, body[pos:])
                    except Exception as e:
                        self.log(f"on_message: {e}")


# ---------- комната ----------

class Room:
    """Протокол комнаты поверх MQTT.
    Топики (все под NS/КОД/):
      room        — инфо о комнате (retained, ведущий)
      st          — состояние воспроизведения (retained, ведущий)
      end         — ведущий закончил (retained)
      p/<uid>     — присутствие участника (retained; «завещание» = ушёл)
      chat        — сообщения
      ping/<uid>, pong/<uid> — сверка часов
    """

    def __init__(self, uid, name, events, clock=now_ms, client_factory=None, endpoints=None):
        self.uid = int(uid)
        self.name = name
        self.ev = events            # объект с методами on_*
        self.clock = clock
        self.code = None
        self.role = None
        self.info = None
        self.st = None
        self.members = {}           # uid -> {"n", "s", "pc", "host"}
        self.offset = 0             # часы ведущего − мои
        self.rtt = None
        self.samples = []
        self.ended = False
        self.presence = {"s": "joined", "pc": 0}
        self._client_factory = client_factory or MqttClient
        self._endpoints = endpoints
        self.client = None
        self.status = "подключаюсь"

    # --- общее ---

    def t(self, suffix):
        return f"{NS}/{self.code}/{suffix}"

    def room_now(self):
        return self.clock() + (self.offset if self.role == "guest" else 0)

    def _endpoints_for(self, code):
        if self._endpoints is not None:
            return self._endpoints
        host, ports = BROKERS[broker_of(code)]
        return [(host, p, tls) for p, tls in ports]

    def _start(self):
        self.client = self._client_factory(self._on_message, self._on_connect, self._on_status,
                                           getattr(self.ev, "on_log", None))
        will = (self.t(f"p/{self.uid}"), {"s": "gone"}, True)
        self.client.configure(self._endpoints_for(self.code), will)
        self.client.subscribe(f"{NS}/{self.code}/#")
        self.client.start()

    def _on_status(self, s):
        self.status = s
        cb = getattr(self.ev, "on_status", None)
        if cb:
            cb(s)

    def _on_connect(self):
        self._publish_presence()
        if self.role == "host":
            self.client.publish(self.t("end"), b"", retain=True)
            self.client.publish(self.t("room"), self.info, retain=True)
            if self.st is not None:
                self.client.publish(self.t("st"), self.st, retain=True)
        else:
            self.ping()

    def _publish_presence(self):
        p = dict(self.presence)
        p.update({"n": self.name, "host": self.role == "host", "ts": self.clock()})
        self.members[self.uid] = p
        if self.client is not None:
            self.client.publish(self.t(f"p/{self.uid}"), p, retain=True)

    # --- ведущий ---

    def host(self, code, info):
        self.role, self.code = "host", code
        self.info = dict(info, host=self.uid, hn=self.name, v=3)
        self.presence = {"s": "ready", "pc": 100}
        self._start()

    def publish_state(self, p, pos, r, ts=None):
        self.st = {"p": bool(p), "pos": int(pos), "r": float(r), "ts": int(ts if ts is not None else self.clock())}
        if self.client is not None:
            self.client.publish(self.t("st"), self.st, retain=True)

    # --- зритель ---

    def join(self, code):
        self.role, self.code = "guest", code
        self._start()

    def ping(self):
        if self.client is not None and self.role == "guest":
            self.client.publish(self.t(f"ping/{self.uid}"), {"a": self.clock()})

    def set_progress(self, stage, pc=0):
        self.presence = {"s": stage, "pc": int(pc)}
        self._publish_presence()

    # --- общее ---

    def chat(self, text, at):
        msg = {"u": self.uid, "n": self.name, "x": text[:300], "at": int(at)}
        if self.client is not None:
            self.client.publish(self.t("chat"), msg)
        return msg

    def close(self):
        """Ведущий — закончить для всех, зритель — выйти."""
        c = self.client
        if c is None:
            return
        if self.role == "host":
            c.publish(self.t("end"), {"end": 1, "ts": self.clock()}, retain=True)
            c.publish(self.t("st"), b"", retain=True)
            c.publish(self.t("room"), b"", retain=True)
        c.publish(self.t(f"p/{self.uid}"), b"", retain=True)
        time.sleep(0.2)
        c.stop(graceful=True)
        self.client = None

    # --- входящие ---

    def _on_message(self, topic, payload):
        prefix = f"{NS}/{self.code}/"
        if not topic.startswith(prefix):
            return
        key = topic[len(prefix):]
        data = None
        if payload:
            try:
                data = json.loads(payload.decode("utf-8"))
            except Exception:
                return
        ev = self.ev
        if key == "room":
            if data and self.role == "guest":
                self.info = data
                ev.on_room(data)
        elif key == "st":
            if data and self.role == "guest":
                self.st = data
                ev.on_state(data)
        elif key == "end":
            if data and self.role == "guest" and not self.ended:
                self.ended = True
                ev.on_end()
        elif key.startswith("p/"):
            try:
                uid = int(key[2:])
            except ValueError:
                return
            if uid == self.uid:
                return
            if not data or data.get("s") == "gone":
                if self.members.pop(uid, None) is not None:
                    ev.on_members(self.members, left=uid)
            else:
                new = uid not in self.members
                self.members[uid] = data
                ev.on_members(self.members, joined=uid if new else None)
        elif key == "chat":
            if data and int(data.get("u") or 0) != self.uid:
                ev.on_chat(data)
        elif key.startswith("ping/") and self.role == "host" and data:
            self.client.publish(self.t("pong/" + key[5:]), {"a": data.get("a"), "b": self.clock()})
        elif key == f"pong/{self.uid}" and self.role == "guest" and data:
            a, b = int(data.get("a") or 0), int(data.get("b") or 0)
            rtt = self.clock() - a
            if a and b and rtt >= 0:
                self.samples = (self.samples + [(rtt, b + rtt // 2 - self.clock())])[-8:]
                self.rtt, self.offset = min(self.samples)
# ===== PURE END =====


# ---------------- обёртки Java-интерфейсов ----------------

def listeners():
    """Классы-обёртки создаются при первом использовании, чтобы плагин грузился даже без них."""
    if hasattr(listeners, "cache"):
        return listeners.cache
    from android.media import MediaPlayer
    from android.widget import SeekBar
    from android.content import DialogInterface

    class Prepared(dynamic_proxy(MediaPlayer.OnPreparedListener)):
        def __init__(self, fn):
            super().__init__()
            self.fn = fn

        def onPrepared(self, mp):
            self.fn(mp)

    class Completed(dynamic_proxy(MediaPlayer.OnCompletionListener)):
        def __init__(self, fn):
            super().__init__()
            self.fn = fn

        def onCompletion(self, mp):
            self.fn(mp)

    class Failed(dynamic_proxy(MediaPlayer.OnErrorListener)):
        def __init__(self, fn):
            super().__init__()
            self.fn = fn

        def onError(self, mp, what, extra):
            self.fn(what, extra)
            return True

    class Seek(dynamic_proxy(SeekBar.OnSeekBarChangeListener)):
        def __init__(self, on_change, on_start, on_stop):
            super().__init__()
            self.on_change, self.on_start, self.on_stop = on_change, on_start, on_stop

        def onProgressChanged(self, sb, progress, from_user):
            self.on_change(int(progress), bool(from_user))

        def onStartTrackingTouch(self, sb):
            self.on_start()

        def onStopTrackingTouch(self, sb):
            self.on_stop(int(sb.getProgress()))

    class Keys(dynamic_proxy(DialogInterface.OnKeyListener)):
        def __init__(self, fn):
            super().__init__()
            self.fn = fn

        def onKey(self, dialog, code, event):
            if code == 4:  # «назад»
                if event.getAction() == 1:
                    self.fn()
                return True
            return False

    class Dismissed(dynamic_proxy(DialogInterface.OnDismissListener)):
        def __init__(self, fn):
            super().__init__()
            self.fn = fn

        def onDismiss(self, dialog):
            self.fn()

    listeners.cache = dict(Prepared=Prepared, Completed=Completed, Failed=Failed,
                           Seek=Seek, Keys=Keys, Dismissed=Dismissed)
    return listeners.cache


def make_new_messages_observer(plugin):
    """Запасной путь приёма команд — если хук обновлений не сработал.
    Класс создаётся внутри функции: если что-то пойдёт не так, плагин всё равно загрузится."""
    class NewMessages(dynamic_proxy(NotificationCenter.NotificationCenterDelegate)):
        def __init__(self):
            super().__init__()

        def didReceivedNotification(self, id, account, args):
            try:
                if id == NotificationCenter.didReceiveNewMessages:
                    plugin.on_new_messages(int(args[0]), args[1])
            except Exception as e:
                plugin.log_err(f"didReceiveNewMessages: {e}")

    return NewMessages()


# ---------------- плеер ----------------

class Player:
    """Полноэкранный плеер Wtogether."""

    def __init__(self, plugin, mo):
        from android.app import Dialog
        from android import R as AR
        from android.view import WindowManager

        self.p = plugin
        self.mo = mo
        self.alive = True
        self.vv = None
        self.mp = None
        self.prepared = False
        self.duration = 0
        self.dragging = False
        self.seek_block_until = 0.0
        self.speed = 1.0
        self.countdown_at = 0
        self.bubbles = []
        self.heads_sig = None
        self.controls_shown = True
        self.last_beat = 0.0
        self.local_path = None

        self.act = plugin.activity()
        if self.act is None:
            raise RuntimeError("нет активного окна")
        self.prev_orientation = self.act.getRequestedOrientation()
        self.build()

        L = listeners()
        self.dialog = Dialog(self.act, AR.style.Theme_Black_NoTitleBar_Fullscreen)
        self.dialog.setContentView(self.root)
        self.dialog.setCancelable(False)
        self.dialog.setOnKeyListener(L["Keys"](lambda: self.p.run_safe(self.p.ask_close)))
        self.dialog.setOnDismissListener(L["Dismissed"](lambda: self.p.run_safe(self.on_dismissed)))
        w = self.dialog.getWindow()
        w.addFlags(WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON)
        w.setSoftInputMode(16)  # adjustResize
        self.dialog.show()

        self.load()
        run_on_ui_thread(self.tick, TICK_MS)

    # ---------- построение интерфейса ----------

    def build(self):
        from android.widget import FrameLayout, LinearLayout, TextView, SeekBar, EditText, VideoView
        from android.view import Gravity
        from android.graphics import Color, Typeface
        from android.graphics.drawable import GradientDrawable
        from android.content.res import ColorStateList
        from org.telegram.messenger import AndroidUtilities

        self.FL, self.LL, self.TV = FrameLayout, LinearLayout, TextView
        self.Gravity, self.Color, self.Typeface, self.GD = Gravity, Color, Typeface, GradientDrawable
        dp = self.dp = lambda v: AndroidUtilities.dp(float(v))
        ctx = self.act
        host = self.p.is_host()

        self.root = FrameLayout(ctx)
        self.root.setBackgroundColor(Color.BLACK)
        self.root.setOnClickListener(OnClickListener(lambda v: self.toggle_controls()))

        # видео
        self.vv = VideoView(ctx)
        self.root.addView(self.vv, FrameLayout.LayoutParams(-1, -1, Gravity.CENTER))

        # центр: загрузка, лобби, отсчёт
        self.center = LinearLayout(ctx)
        self.center.setOrientation(LinearLayout.VERTICAL)
        self.center.setGravity(Gravity.CENTER)
        self.big = self.text("", 44.0, True)
        self.big.setGravity(Gravity.CENTER)
        self.center.addView(self.big, LinearLayout.LayoutParams(-2, -2))
        self.info = self.text("", 15.0)
        self.info.setGravity(Gravity.CENTER)
        self.info.setPadding(dp(24), dp(6), dp(24), dp(6))
        self.center.addView(self.info, LinearLayout.LayoutParams(-2, -2))
        self.start_btn = self.pill("▶  Начать для всех", ACCENT, lambda: self.p.host_start())
        slp = LinearLayout.LayoutParams(-2, -2)
        slp.topMargin = dp(16)
        self.center.addView(self.start_btn, slp)
        self.start_btn.setVisibility(8)
        self.root.addView(self.center, FrameLayout.LayoutParams(-1, -2, Gravity.CENTER))

        # верх: закрыть, заголовок, головы
        self.top = LinearLayout(ctx)
        self.top.setOrientation(LinearLayout.HORIZONTAL)
        self.top.setGravity(Gravity.CENTER_VERTICAL)
        self.top.setPadding(dp(8), dp(28), dp(12), dp(10))
        self.top.setBackground(self.grad(True))
        close = self.round_btn("✕", DARK, 40, lambda: self.p.ask_close(), 16.0)
        self.top.addView(close, LinearLayout.LayoutParams(dp(40), dp(40)))
        titles = LinearLayout(ctx)
        titles.setOrientation(LinearLayout.VERTICAL)
        self.title = self.text("Wtogether", 16.0, True)
        self.title.setSingleLine(True)
        self.subtitle = self.text("", 12.5)
        self.subtitle.setSingleLine(True)
        self.subtitle.setAlpha(0.8)
        titles.addView(self.title)
        titles.addView(self.subtitle)
        tlp = LinearLayout.LayoutParams(0, -2, 1.0)
        tlp.leftMargin = dp(10)
        self.top.addView(titles, tlp)
        self.faces = LinearLayout(ctx)
        self.faces.setOrientation(LinearLayout.HORIZONTAL)
        self.faces.setPadding(dp(4), dp(4), dp(4), dp(4))
        self.faces.setBackground(self.shape(DARK, dp(20)))
        self.faces.setOnClickListener(OnClickListener(lambda v: self.p.open_panel()))
        self.top.addView(self.faces, LinearLayout.LayoutParams(-2, -2))
        self.root.addView(self.top, FrameLayout.LayoutParams(-1, -2, Gravity.TOP))

        # лента сообщений
        self.feed = LinearLayout(ctx)
        self.feed.setOrientation(LinearLayout.VERTICAL)
        flp = FrameLayout.LayoutParams(dp(280), -2, Gravity.BOTTOM | Gravity.START)
        flp.leftMargin = dp(12)
        flp.bottomMargin = dp(212)
        self.root.addView(self.feed, flp)

        # низ: ползунок, кнопки, сообщение
        self.bottom = LinearLayout(ctx)
        self.bottom.setOrientation(LinearLayout.VERTICAL)
        self.bottom.setPadding(dp(12), dp(16), dp(12), dp(14))
        self.bottom.setBackground(self.grad(False))
        self.bottom.setOnClickListener(OnClickListener(lambda v: None))  # не прячем по нажатию на панель

        row = LinearLayout(ctx)
        row.setOrientation(LinearLayout.HORIZONTAL)
        row.setGravity(Gravity.CENTER_VERTICAL)
        self.time_cur = self.text("0:00", 12.5, True)
        row.addView(self.time_cur)
        self.seek = SeekBar(ctx)
        self.seek.setMax(1000)
        try:
            tint = ColorStateList.valueOf(Color.parseColor(ACCENT))
            self.seek.setProgressTintList(tint)
            self.seek.setThumbTintList(tint)
        except Exception:
            pass
        L = listeners()
        self.seek.setOnSeekBarChangeListener(L["Seek"](self.on_seek_change, self.on_seek_start, self.on_seek_stop))
        self.seek.setEnabled(host)
        row.addView(self.seek, LinearLayout.LayoutParams(0, -2, 1.0))
        self.time_all = self.text("0:00", 12.5, True)
        row.addView(self.time_all)
        self.bottom.addView(row, LinearLayout.LayoutParams(-1, -2))

        ctl = LinearLayout(ctx)
        ctl.setOrientation(LinearLayout.HORIZONTAL)
        ctl.setGravity(Gravity.CENTER)
        p = self.p
        self.btn_play = None
        self.btn_speed = None
        if host:
            items = [("−10", DARK, lambda: p.host_skip(-SKIP_MS), 46, 15.0),
                     ("▶", ACCENT, p.host_toggle, 58, 24.0),
                     ("+10", DARK, lambda: p.host_skip(SKIP_MS), 46, 15.0),
                     ("1×", DARK, p.host_speed, 46, 14.0)]
        else:
            items = [("🔄", DARK, p.catch_up, 48, 18.0)]
        if host:
            items += [("🔗", DARK, p.share_code, 46, 17.0)]
        items += [("📞", DARK, p.start_call, 46, 17.0), ("⤢", DARK, self.rotate, 46, 17.0)]
        for text, color, fn, size, ts in items:
            b = self.round_btn(text, color, size, fn, ts)
            if text == "▶":
                self.btn_play = b
            if text == "1×":
                self.btn_speed = b
            blp = LinearLayout.LayoutParams(dp(size), dp(size))
            blp.leftMargin = dp(4)
            blp.rightMargin = dp(4)
            ctl.addView(b, blp)
        clp = LinearLayout.LayoutParams(-1, -2)
        clp.topMargin = dp(6)
        self.bottom.addView(ctl, clp)

        if not host:
            self.lock = self.text("🔒 Управляет ведущий", 12.5)
            self.lock.setGravity(Gravity.CENTER)
            self.lock.setAlpha(0.75)
            llp = LinearLayout.LayoutParams(-1, -2)
            llp.topMargin = dp(6)
            self.bottom.addView(self.lock, llp)

        say = LinearLayout(ctx)
        say.setOrientation(LinearLayout.HORIZONTAL)
        say.setGravity(Gravity.CENTER_VERTICAL)
        self.input = EditText(ctx)
        self.input.setHint("Сообщение всем…")
        self.input.setTextColor(Color.WHITE)
        self.input.setHintTextColor(Color.parseColor("#99FFFFFF"))
        self.input.setSingleLine(True)
        self.input.setTextSize(15.0)
        self.input.setPadding(dp(16), dp(10), dp(16), dp(10))
        self.input.setBackground(self.shape("#33FFFFFF", dp(22)))
        say.addView(self.input, LinearLayout.LayoutParams(0, -2, 1.0))
        send = self.round_btn("➤", ACCENT, 44, self.send_input, 17.0)
        sl = LinearLayout.LayoutParams(dp(44), dp(44))
        sl.leftMargin = dp(8)
        say.addView(send, sl)
        sylp = LinearLayout.LayoutParams(-1, -2)
        sylp.topMargin = dp(12)
        self.bottom.addView(say, sylp)

        self.root.addView(self.bottom, FrameLayout.LayoutParams(-1, -2, Gravity.BOTTOM))

        Prepared, Completed, Failed = L["Prepared"], L["Completed"], L["Failed"]
        self.vv.setOnPreparedListener(Prepared(lambda mp: self.p.run_safe(lambda: self.on_prepared(mp))))
        self.vv.setOnCompletionListener(Completed(lambda mp: self.p.run_safe(lambda: self.p.on_completed())))
        self.vv.setOnErrorListener(Failed(lambda w, e: self.p.run_safe(lambda: self.on_error(w, e))))

    def text(self, s, size=14.0, bold=False):
        t = self.TV(self.act)
        t.setText(s)
        t.setTextColor(self.Color.WHITE)
        t.setTextSize(size)
        if bold:
            t.setTypeface(self.Typeface.DEFAULT_BOLD)
        return t

    def shape(self, color, radius, oval=False):
        d = self.GD()
        d.setColor(self.Color.parseColor(color))
        if oval:
            d.setShape(self.GD.OVAL)
        else:
            d.setCornerRadius(float(radius))
        return d

    def grad(self, top):
        from java import jarray, jint
        colors = jarray(jint)([self.Color.parseColor("#D9000000"), self.Color.parseColor("#00000000")])
        orient = self.GD.Orientation.TOP_BOTTOM if top else self.GD.Orientation.BOTTOM_TOP
        return self.GD(orient, colors)

    def round_btn(self, label, color, size, fn, ts=15.0):
        b = self.text(label, ts, True)
        b.setGravity(self.Gravity.CENTER)
        b.setBackground(self.shape(color, 0, oval=True))
        b.setOnClickListener(OnClickListener(lambda v: self.p.run_safe(fn)))
        return b

    def pill(self, label, color, fn):
        dp = self.dp
        b = self.text(label, 16.0, True)
        b.setGravity(self.Gravity.CENTER)
        b.setPadding(dp(24), dp(12), dp(24), dp(13))
        b.setBackground(self.shape(color, dp(26)))
        b.setOnClickListener(OnClickListener(lambda v: self.p.run_safe(fn)))
        return b

    def head(self, user, name, dot, crown):
        dp = self.dp
        box = self.FL(self.act)
        box.setBackground(self.shape("#FFFFFF", 0, oval=True))
        box.setPadding(dp(2), dp(2), dp(2), dp(2))
        pic = None
        try:
            if user is not None:
                from org.telegram.ui.Components import BackupImageView, AvatarDrawable
                pic = BackupImageView(self.act)
                pic.setRoundRadius(dp(15))
                pic.setForUserOrChat(user, AvatarDrawable(user))
        except Exception as e:
            self.p.log_err(f"аватарка: {e}")
            pic = None
        if pic is None:
            pic = self.text((name or "?")[:1].upper(), 14.0, True)
            pic.setGravity(self.Gravity.CENTER)
            pic.setBackground(self.shape(ACCENT, 0, oval=True))
        box.addView(pic, self.FL.LayoutParams(-1, -1))
        d = self.TV(self.act)
        d.setBackground(self.shape(dot, 0, oval=True))
        box.addView(d, self.FL.LayoutParams(dp(10), dp(10), self.Gravity.BOTTOM | self.Gravity.END))
        if crown:
            box.addView(self.text("👑", 10.0), self.FL.LayoutParams(-2, -2, self.Gravity.TOP | self.Gravity.END))
        return box

    # ---------- загрузка видео ----------

    def load(self):
        path = self.p.local_path(self.mo)
        if path:
            self.open_file(path)
            return
        self.big.setText("⏬")
        self.info.setText("Загружаю видео…")
        self.p.download(self.mo)
        self.poll_download()

    def poll_download(self):
        if not self.alive:
            return
        path = self.p.local_path(self.mo)
        if path:
            self.open_file(path)
            return
        pc = self.p.download_percent(self.mo)
        self.info.setText(f"Загружаю видео… {pc}%" if pc else "Загружаю видео…")
        self.p.report_progress(pc)
        run_on_ui_thread(self.poll_download, 500)

    def open_file(self, path):
        self.local_path = path
        self.big.setText("")
        self.info.setText("Готовлю плеер…")
        self.vv.setVideoPath(path)

    def on_prepared(self, mp):
        self.mp = mp
        self.prepared = True
        self.duration = int(mp.getDuration())
        self.time_all.setText(fmt_time(self.duration))
        try:
            mp.setLooping(False)
        except Exception:
            pass
        self.vv.seekTo(0)
        self.p.on_player_ready()

    def on_error(self, what, extra):
        self.p.log_err(f"плеер: ошибка {what}/{extra}")
        self.big.setText("⚠️")
        self.info.setText("Это видео не открывается на устройстве")

    # ---------- управление ----------

    def position(self):
        try:
            return int(self.vv.getCurrentPosition()) if self.prepared else 0
        except Exception:
            return 0

    def playing(self):
        try:
            return bool(self.vv.isPlaying())
        except Exception:
            return False

    def seek_to(self, ms):
        if not self.prepared:
            return
        ms = max(0, min(int(ms), max(0, self.duration - 300)))
        try:
            if self.mp is not None:
                self.mp.seekTo(ms, 3)  # SEEK_CLOSEST — точно в нужный кадр
            else:
                self.vv.seekTo(ms)
        except Exception:
            self.vv.seekTo(ms)
        self.seek_block_until = time.time() + SEEK_COOLDOWN

    def play(self):
        if self.prepared and not self.playing():
            self.vv.start()

    def pause(self):
        if self.prepared and self.playing():
            self.vv.pause()

    def set_speed(self, x):
        x = round(float(x), 3)
        if abs(x - self.speed) < 0.001 or self.mp is None or not self.playing():
            return
        try:
            params = self.mp.getPlaybackParams()
            params.setSpeed(x)
            self.mp.setPlaybackParams(params)
            self.speed = x
        except Exception as e:
            self.p.log_err(f"скорость: {e}")

    # ---------- ползунок ----------

    def on_seek_change(self, progress, from_user):
        if from_user and self.duration:
            self.time_cur.setText(fmt_time(self.duration * progress / 1000))

    def on_seek_start(self):
        self.dragging = True

    def on_seek_stop(self, progress):
        self.dragging = False
        if self.p.is_host() and self.duration:
            self.p.host_seek(int(self.duration * progress / 1000))

    # ---------- цикл ----------

    def tick(self):
        if not self.alive:
            return
        try:
            self.p.on_tick(self)
            if self.prepared and not self.dragging:
                pos = self.position()
                self.time_cur.setText(fmt_time(pos))
                if self.duration:
                    self.seek.setProgress(int(pos * 1000 / self.duration))
            if self.btn_play is not None:
                self.btn_play.setText("⏸" if self.playing() else "▶")
            self.refresh_faces()
        except Exception as e:
            self.p.log_err(f"tick: {e}")
        run_on_ui_thread(self.tick, TICK_MS)

    def refresh_faces(self):
        people = self.p.lobby_people()
        sig = tuple((n, c, cr) for _, n, c, cr in people)
        if sig == self.heads_sig:
            return
        self.heads_sig = sig
        dp = self.dp
        self.faces.removeAllViews()
        for i, (user, name, dot, crown) in enumerate(people[:6]):
            lp = self.LL.LayoutParams(dp(32), dp(32))
            if i:
                lp.leftMargin = -dp(8)
            self.faces.addView(self.head(user, name, dot, crown), lp)
        if len(people) > 6:
            more = self.text(f"+{len(people) - 6}", 12.0, True)
            ml = self.LL.LayoutParams(-2, -2)
            ml.leftMargin = dp(4)
            self.faces.addView(more, ml)

    def set_state(self, big, info, show_start=False):
        self.big.setText(big or "")
        self.info.setText(info or "")
        self.center.setVisibility(0 if (big or info or show_start) else 8)
        self.start_btn.setVisibility(0 if show_start else 8)

    def set_titles(self, title, subtitle):
        self.title.setText(title)
        self.subtitle.setText(subtitle)

    def toggle_controls(self):
        self.controls_shown = not self.controls_shown
        a = 1.0 if self.controls_shown else 0.0
        for v in (self.top, self.bottom):
            v.setVisibility(0)
            v.animate().alpha(a).setDuration(200).start()

        def hide():
            if not self.controls_shown:
                self.top.setVisibility(4)
                self.bottom.setVisibility(4)
        if not self.controls_shown:
            run_on_ui_thread(hide, 220)

    def rotate(self):
        try:
            cur = self.act.getRequestedOrientation()
            self.act.setRequestedOrientation(-1 if cur == 6 else 6)  # SENSOR_LANDSCAPE ↔ как было
        except Exception as e:
            self.p.log_err(f"поворот: {e}")

    # ---------- сообщения ----------

    def send_input(self):
        t = str(self.input.getText()).strip()
        if t:
            self.input.setText("")
            self.p.say_all(t)

    def bubble(self, who, text, mine=False):
        if not self.alive:
            return
        dp = self.dp
        t = self.text(f"{who}: {text}", 14.0)
        t.setPadding(dp(12), dp(7), dp(12), dp(8))
        t.setBackground(self.shape(ACCENT if mine else PANEL, dp(16)))
        lp = self.LL.LayoutParams(-2, -2)
        lp.topMargin = dp(6)
        self.feed.addView(t, lp)
        self.bubbles.append(t)
        while len(self.bubbles) > 4:
            self.feed.removeView(self.bubbles.pop(0))

        def fade():
            if t in self.bubbles:
                self.bubbles.remove(t)
                try:
                    self.feed.removeView(t)
                except Exception:
                    pass
        run_on_ui_thread(fade, 8000)

    # ---------- закрытие ----------

    def close(self):
        if not self.alive:
            return
        self.alive = False
        try:
            self.vv.stopPlayback()
        except Exception:
            pass
        try:
            self.dialog.dismiss()
        except Exception:
            pass

    def on_dismissed(self):
        self.alive = False
        try:
            self.act.setRequestedOrientation(self.prev_orientation)
        except Exception:
            pass
        self.p.on_player_closed(self)


# ---------------- плагин ----------------

# ---------------- плагин ----------------

class RoomEvents:
    """События комнаты приходят из сетевого потока — переносим в главный."""
    def __init__(self, plugin):
        self.p = plugin

    def _ui(self, fn):
        run_on_ui_thread(lambda: self.p.run_safe(fn))

    def on_room(self, info):
        self._ui(lambda: self.p.on_room(info))

    def on_state(self, st):
        self._ui(lambda: self.p.on_state(st))

    def on_end(self):
        self._ui(self.p.on_end)

    def on_members(self, members, joined=None, left=None):
        self._ui(lambda: self.p.on_members(joined, left))

    def on_chat(self, msg):
        self._ui(lambda: self.p.on_chat(msg))

    def on_status(self, s):
        self._ui(lambda: self.p.on_status(s))

    def on_log(self, s):
        self.p.log_err(f"связь: {s}")


class WtogetherPlugin(BasePlugin):

    def on_plugin_load(self):
        self.room = None
        self.mo = None
        self.player = None
        self.started = False
        self.talk = []
        self.errors = []
        self.seen = set()
        self.last_beat = 0.0
        self.last_ping = 0.0
        self.nudging = False
        self.last_prog = -1
        self.join_deadline = 0
        self.chat_did = 0
        self.running = True

        self.add_hook("TL_updateNewMessage")
        self.add_hook("TL_updateShortMessage")
        try:
            self.nc_delegate = make_new_messages_observer(self)
            get_notification_center().addObserver(self.nc_delegate, NotificationCenter.didReceiveNewMessages)
        except Exception as e:
            self.nc_delegate = None
            self.log_err(f"NotificationCenter: {e}")

        self.add_menu_item(MenuItemData(menu_type=MenuItemType.MESSAGE_CONTEXT_MENU,
                                        text="🎬 Смотреть вместе", on_click=self.on_watch_click))
        self.add_menu_item(MenuItemData(menu_type=MenuItemType.CHAT_ACTION_MENU,
                                        text="🎬 Wtogether", on_click=lambda ctx: self.open_panel()))
        try:
            self.add_menu_item(MenuItemData(menu_type=MenuItemType.DRAWER_MENU,
                                            text="Wtogether: войти по коду", on_click=lambda ctx: self.ask_code()))
        except Exception as e:
            self.log_err(f"меню: {e}")
        self.logger.info(f"Wtogether {__version__} загружен")

    def on_plugin_unload(self):
        self.running = False
        try:
            if self.nc_delegate is not None:
                get_notification_center().removeObserver(self.nc_delegate, NotificationCenter.didReceiveNewMessages)
        except Exception:
            pass
        self.close_room()
        if self.player is not None:
            run_on_ui_thread(self.player.close)

    # ---------- общее ----------

    def log_err(self, text):
        self.logger.error(str(text))
        self.errors.append(time.strftime("%H:%M:%S ") + str(text))
        self.errors = self.errors[-20:]

    def run_safe(self, fn):
        try:
            fn()
        except Exception as e:
            self.log_err(f"действие: {e}")
            BulletinHelper.show_error("Ошибка — подробности в «Проверка работы»")

    def is_host(self):
        return self.room is not None and self.room.role == "host"

    def is_guest(self):
        return self.room is not None and self.room.role == "guest"

    def activity(self):
        if self.player is not None and self.player.alive:
            return self.player.act
        frag = get_last_fragment()
        return frag.getParentActivity() if frag else None

    def notify_user(self, text):
        if self.player is not None and self.player.alive:
            self.player.bubble("Wtogether", text)
        elif self.get_setting("notify", True):
            BulletinHelper.show_info(text)

    def me_user(self):
        try:
            from org.telegram.messenger import UserConfig
            return UserConfig.getInstance(UserConfig.selectedAccount).getCurrentUser()
        except Exception:
            return None

    def my_uid(self):
        try:
            from org.telegram.messenger import UserConfig
            return int(UserConfig.getInstance(UserConfig.selectedAccount).getClientUserId())
        except Exception:
            return 0

    def my_name(self):
        u = self.me_user()
        return u.first_name if u is not None and u.first_name else "Я"

    def tg_user(self, uid):
        try:
            return get_messages_controller().getUser(Long(int(uid)))
        except Exception:
            return None

    def host_name(self):
        if self.room is None:
            return ""
        if self.is_host():
            return self.my_name()
        return (self.room.info or {}).get("hn") or "ведущий"

    # ---------- видеофайл ----------

    def doc_of(self, mo):
        try:
            d = mo.getDocument()
            return int(d.id) if d is not None else 0
        except Exception:
            return 0

    def local_path(self, mo):
        from java.io import File
        try:
            ap = mo.messageOwner.attachPath
            if ap and File(ap).exists() and File(ap).length() > 0:
                return str(ap)
        except Exception:
            pass
        try:
            f = get_file_loader().getPathToMessage(mo.messageOwner)
            if f is not None and f.exists() and f.length() > 0:
                return str(f.getAbsolutePath())
        except Exception as e:
            self.log_err(f"путь к файлу: {e}")
        return None

    def download(self, mo):
        try:
            get_file_loader().loadFile(mo.getDocument(), mo, 3, 0)
        except Exception as e:
            self.log_err(f"загрузка: {e}")

    def download_percent(self, mo):
        try:
            from java.io import File
            from org.telegram.messenger import FileLoader
            doc = mo.getDocument()
            tmp = File(get_file_loader().getDirectory(4), FileLoader.getAttachFileName(doc) + ".temp")
            if tmp.exists() and doc.size > 0:
                return max(0, min(99, int(tmp.length() * 100 / doc.size)))
        except Exception:
            pass
        return 0

    def report_progress(self, pc):
        if self.is_guest() and pc // 10 != self.last_prog // 10:
            self.last_prog = pc
            self.room.set_progress("loading", pc)

    def video_title(self, mo):
        try:
            name = mo.getDocumentName() if hasattr(mo, "getDocumentName") else None
            cap = str(mo.caption) if getattr(mo, "caption", None) else ""
            return (cap.strip().split("\n")[0][:60] or (str(name) if name else "") or "Видео")
        except Exception:
            return "Видео"

    # ---------- создание комнаты ----------

    def on_watch_click(self, context):
        self.run_safe(lambda: self.start_host(context.get("message")))

    def start_host(self, mo, broker_index=0):
        if mo is None or not mo.isVideo():
            BulletinHelper.show_error("Выбери сообщение с видео")
            return
        if self.room is not None:
            self.confirm("Уже идёт просмотр", "Закончить текущий и начать с этим видео?", "Начать",
                         lambda: (self.end_session(), self.start_host(mo)))
            return
        self.mo = mo
        self.started = False
        self.talk = []
        code = new_code(broker_index)
        info = {"doc": self.doc_of(mo), "title": self.video_title(mo)}
        try:
            info["dur"] = int(mo.getDuration() * 1000)
        except Exception:
            pass
        self.room = Room(self.my_uid(), self.my_name(), RoomEvents(self))
        self.room.host(code, info)
        self.chat_did = int(mo.getDialogId())
        self.open_player(mo)
        self.share_code()
        # если брокер недоступен — пробуем следующий, пока никто не зашёл
        run_on_ui_thread(lambda: self.check_host_connection(broker_index), 9000)

    def check_host_connection(self, broker_index):
        r = self.room
        if r is None or not self.is_host() or (r.client and r.client.connected):
            return
        if len(r.members) > 1 or broker_index + 1 >= len(BROKERS):
            return
        self.log_err(f"брокер {BROKERS[broker_index][0]} недоступен, пробую следующий")
        mo = self.mo
        self.close_room()
        pl, self.player = self.player, None
        if pl is not None:
            pl.close()
        self.start_host(mo, broker_index + 1)

    def share_code(self):
        if not self.is_host():
            return
        code = self.room.code
        did = getattr(self, "chat_did", 0)

        def send_to_chat():
            text = (f"🎬 Смотрим вместе в Wtogether!\nКод комнаты: {code}\n\n"
                    "Нажми «Смотреть» во всплывшем окне или: меню чата ⋮ → «🎬 Wtogether» → «Войти по коду». "
                    "Нужен плагин Wtogether для exteraGram." + zw_encode({"t": "code", "c": code}))
            try:
                send_text(did, text, replyToMsg=self.mo)
            except Exception:
                send_text(did, text)
            BulletinHelper.show_success("Код отправлен в чат")

        def ui():
            act = self.activity()
            if act is None:
                return
            b = AlertDialogBuilder(act)
            b.set_title(f"Код комнаты: {code}")
            b.set_message("Отправь код другу. Он вводит его в Wtogether и попадает к тебе в комнату.\n\n"
                          "Можно позвать сразу нескольких человек — у всех один и тот же код.")
            if did > 0:
                b.set_positive_button("Отправить в чат", lambda bb, w: (bb.dismiss(), self.run_safe(send_to_chat)))
            b.set_neutral_button("Скопировать", lambda bb, w: (bb.dismiss(), copy_to_clipboard(code)))
            b.set_negative_button("Закрыть", lambda bb, w: bb.dismiss())
            b.show()
        run_on_ui_thread(ui)

    # ---------- вход по коду ----------

    def ask_code(self, prefill=""):
        holder = {}

        def ui():
            act = self.activity()
            if act is None:
                return
            from android.widget import EditText
            e = EditText(act)
            e.setHint("Например: K7P4QD")
            e.setText(prefill)
            e.setSingleLine(True)
            e.setTextSize(22.0)
            e.setGravity(17)
            try:
                e.setInputType(0x1001)  # текст, ЗАГЛАВНЫЕ
                from org.telegram.ui.ActionBar import Theme
                e.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
                e.setHintTextColor(Theme.getColor(Theme.key_dialogTextHint))
            except Exception:
                pass
            holder["e"] = e
            b = AlertDialogBuilder(act)
            b.set_title("🎬 Войти по коду")
            b.set_view(e)

            def go(bb, w):
                bb.dismiss()
                code = normalize_code(str(holder["e"].getText()))
                if not code:
                    BulletinHelper.show_error("Код — 6 символов, например K7P4QD")
                    return
                self.run_safe(lambda: self.join_code(code))
            b.set_positive_button("Войти", go)
            b.set_negative_button("Отмена", lambda bb, w: bb.dismiss())
            b.show()
        run_on_ui_thread(ui)

    def join_code(self, code):
        if self.room is not None:
            if self.room.code == code:
                if self.player is None and self.mo is not None:
                    self.open_player(self.mo)
                return
            self.confirm("Уже идёт просмотр", "Выйти из текущего и зайти по новому коду?", "Зайти",
                         lambda: (self.end_session(), self.join_code(code)))
            return
        self.mo = None
        self.talk = []
        self.nudging = False
        self.last_prog = -1
        self.room = Room(self.my_uid(), self.my_name(), RoomEvents(self))
        self.room.join(code)
        self.join_deadline = time.time() + 12
        BulletinHelper.show_info(f"Подключаюсь к комнате {code}…")
        run_on_ui_thread(self.check_join, 12500)

    def check_join(self):
        if self.is_guest() and self.room.info is None and time.time() >= self.join_deadline:
            ended = self.room.ended
            self.close_room()
            self.dialog_ok("Комната не найдена",
                           "Просмотр по этому коду уже закончился." if ended else
                           "Проверь код. Если код верный — у ведущего или у тебя нет интернета.")

    def on_room(self, info):
        if not self.is_guest() or self.mo is not None:
            return
        doc = int(info.get("doc") or 0)
        host = int(info.get("host") or 0)
        BulletinHelper.show_info(f"Ищу видео «{info.get('title') or 'Видео'}»…")
        self.find_video(doc, host, lambda mo: self.on_video_found(mo, info))

    def on_video_found(self, mo, info):
        if not self.is_guest():
            return
        if mo is None:
            hn = info.get("hn") or "ведущий"
            self.close_room()
            self.dialog_ok("Нет этого видео",
                           f"У тебя в Telegram не нашлось видео из комнаты.\n\n"
                           f"Попроси {hn} переслать его тебе в личку и снова войди по коду.")
            return
        self.mo = mo
        self.open_player(mo)

    def find_video(self, doc, host, done):
        """Ищем видео: сначала в чате с ведущим, потом во всех чатах."""
        def pick(resp):
            try:
                for i in range(resp.messages.size()):
                    m = resp.messages.get(i)
                    try:
                        if int(m.media.document.id) == doc:
                            from org.telegram.messenger import UserConfig
                            return MessageObject(UserConfig.selectedAccount, m, False, False)
                    except Exception:
                        continue
            except Exception as e:
                self.log_err(f"поиск: {e}")
            return None

        def global_search():
            try:
                req = TLRPC.TL_messages_searchGlobal()
                req.q = ""
                req.filter = TLRPC.TL_inputMessagesFilterVideo()
                req.limit = 100
                req.offset_peer = TLRPC.TL_inputPeerEmpty()

                def cb(resp, err):
                    mo = pick(resp) if err is None and resp is not None else None
                    run_on_ui_thread(lambda: self.run_safe(lambda: done(mo)))
                send_request(req, cb)
            except Exception as e:
                self.log_err(f"глобальный поиск: {e}")
                run_on_ui_thread(lambda: done(None))

        try:
            req = TLRPC.TL_messages_search()
            req.peer = get_messages_controller().getInputPeer(int(host))
            req.q = ""
            req.filter = TLRPC.TL_inputMessagesFilterVideo()
            req.limit = 100

            def cb(resp, err):
                mo = pick(resp) if err is None and resp is not None else None
                if mo is not None:
                    run_on_ui_thread(lambda: self.run_safe(lambda: done(mo)))
                else:
                    global_search()
            send_request(req, cb)
        except Exception as e:
            self.log_err(f"поиск в чате: {e}")
            global_search()

    # ---------- плеер ----------

    def open_player(self, mo):
        if self.player is not None and self.player.alive:
            return
        try:
            self.player = Player(self, mo)
            self.update_ui()
        except Exception as e:
            self.player = None
            self.log_err(f"открыть плеер: {e}")
            BulletinHelper.show_error("Не удалось открыть плеер — см. «Проверка работы»")

    def on_player_ready(self):
        if self.is_guest():
            self.room.set_progress("ready", 100)
        elif self.is_host() and self.room.st is None:
            self.room.publish_state(False, 0, 1.0)
        self.update_ui()

    def on_completed(self):
        if self.is_host():
            self.publish_host_state()
            self.notify_user("Видео закончилось")

    def lobby_people(self):
        r = self.room
        if r is None:
            return []
        dots = {"ready": ONLINE, "loading": WAITING, "joined": OFFLINE}
        people = []
        host_uid = r.uid if self.is_host() else int((r.info or {}).get("host") or 0)
        for uid, m in sorted(r.members.items(), key=lambda kv: (not kv[1].get("host"), kv[0])):
            dot = ONLINE if m.get("host") else dots.get(m.get("s"), OFFLINE)
            people.append((self.tg_user(uid), m.get("n") or "?", dot, uid == host_uid))
        return people

    # ---------- ведущий ----------

    def publish_host_state(self, ts=None):
        pl = self.player
        if self.is_host() and pl is not None and pl.prepared:
            self.room.publish_state(pl.playing(), pl.position(), pl.speed or 1.0, ts)
            self.last_beat = time.time()

    def host_start(self):
        pl = self.player
        if not self.is_host() or pl is None or not pl.prepared:
            return
        at = now_ms() + COUNTDOWN_MS
        self.started = True
        self.room.publish_state(True, pl.position(), pl.speed or 1.0, at)
        pl.countdown_at = at
        self.update_ui()

    def host_toggle(self):
        pl = self.player
        if not self.is_host() or pl is None or not pl.prepared:
            return
        if not self.started:
            self.host_start()
            return
        if pl.playing():
            pl.pause()
        else:
            pl.play()
        self.publish_host_state()

    def host_skip(self, delta):
        pl = self.player
        if self.is_host() and pl is not None and pl.prepared:
            pl.seek_to(pl.position() + delta)
            run_on_ui_thread(self.publish_host_state, 250)

    def host_seek(self, ms):
        pl = self.player
        if self.is_host() and pl is not None and pl.prepared:
            pl.seek_to(ms)
            run_on_ui_thread(self.publish_host_state, 250)

    def host_speed(self):
        pl = self.player
        if not self.is_host() or pl is None:
            return
        if not pl.playing():
            BulletinHelper.show_info("Скорость меняется во время воспроизведения")
            return
        cur = pl.speed or 1.0
        nxt = SPEEDS[(SPEEDS.index(cur) + 1) % len(SPEEDS)] if cur in SPEEDS else 1.0
        pl.set_speed(nxt)
        if pl.btn_speed is not None:
            pl.btn_speed.setText(f"{nxt:g}×")
        self.publish_host_state()

    # ---------- зритель ----------

    def catch_up(self):
        if self.is_guest():
            self.room.ping()
            if self.player is not None:
                self.player.seek_block_until = 0
            BulletinHelper.show_info("Догоняю ведущего…")

    def on_state(self, st):
        self.update_ui()

    def on_end(self):
        hn = self.host_name()
        self.close_room()
        pl, self.player = self.player, None
        if pl is not None:
            pl.close()
        self.dialog_ok("Просмотр закончен", f"{hn} закончил(а) совместный просмотр.")

    # ---------- общие события ----------

    def on_members(self, joined, left):
        r = self.room
        if r is None:
            return
        if joined:
            n = r.members.get(joined, {}).get("n") or "Кто-то"
            self.notify_user(f"🟢 {n} в комнате")
        if left:
            self.notify_user("👋 Участник вышел")
            if self.is_guest() and int((r.info or {}).get("host") or 0) == left:
                self.notify_user("Ведущий отключился — ждём возвращения")
        self.update_ui()

    def on_chat(self, msg):
        who, x = msg.get("n") or "?", str(msg.get("x") or "")[:300]
        self.talk.append((int(msg.get("at") or 0), who, x))
        if self.player is not None:
            self.player.bubble(who, x)
        else:
            self.notify_user(f"💬 {who}: {x}")

    def on_status(self, s):
        if self.player is not None:
            self.update_titles()

    def say_all(self, text):
        if self.room is None:
            return
        at = self.player.position() if self.player is not None else 0
        self.room.chat(text, at)
        self.talk.append((at, self.my_name(), text[:300]))
        if self.player is not None:
            self.player.bubble("Я", text, mine=True)

    def start_call(self):
        r = self.room
        if r is None:
            return
        uids = [u for u in r.members if u != r.uid]
        if not uids:
            BulletinHelper.show_info("В комнате пока никого нет")
            return
        if len(uids) == 1:
            self.call_user(uids[0])
            return
        act = self.activity()
        b = AlertDialogBuilder(act)
        b.set_title("📞 Кому позвонить?")
        b.set_items([r.members[u].get("n") or "?" for u in uids],
                    lambda bb, i: (bb.dismiss(), self.call_user(uids[int(i)])))
        b.set_negative_button("Отмена", lambda bb, w: bb.dismiss())
        b.show()

    def call_user(self, uid):
        try:
            from org.telegram.ui.Components.voip import VoIPHelper
            from org.telegram.messenger import AccountInstance, UserConfig
            mc = get_messages_controller()
            user = mc.getUser(Long(int(uid)))
            if user is None:
                BulletinHelper.show_error("Этого человека нет в твоих чатах — позвони из Telegram")
                return
            full = mc.getUserFull(int(uid))
            VoIPHelper.startCall(user, False, bool(full is not None and full.video_calls_available),
                                 self.activity(), full, AccountInstance.getInstance(UserConfig.selectedAccount))
        except Exception as e:
            self.log_err(f"звонок: {e}")
            BulletinHelper.show_error("Не удалось начать звонок")

    # ---------- цикл плеера ----------

    def on_tick(self, pl):
        r = self.room
        if r is None:
            return
        if self.is_host():
            if pl.countdown_at:
                left = pl.countdown_at - now_ms()
                if left <= 0:
                    pl.countdown_at = 0
                    pl.play()
                    self.update_ui()
                else:
                    pl.set_state(str(left // 1000 + 1), "Старт для всех", False)
            elif pl.playing() and time.time() - self.last_beat > HEARTBEAT_S:
                self.publish_host_state()
            self.update_titles()
            return

        # зритель
        self.update_titles()
        if not pl.prepared:
            return
        if time.time() - self.last_ping > PING_EVERY:
            self.last_ping = time.time()
            r.ping()
        st = r.st
        self.guest_center(pl)
        if st is None:
            pl.pause()
            return
        room_now = r.room_now()
        play, seek, speed, self.nudging = plan_correction(st, room_now, pl.position(), pl.playing(), self.nudging)
        if seek is not None and time.time() > pl.seek_block_until:
            pl.seek_to(seek)
        if play:
            pl.play()
            pl.set_speed(speed)
        else:
            pl.pause()

    def update_titles(self):
        pl, r = self.player, self.room
        if pl is None or not pl.alive or r is None:
            return
        link = r.status
        if self.is_host():
            guests = [m for u, m in r.members.items() if u != r.uid]
            ready = sum(1 for m in guests if m.get("s") == "ready")
            pl.set_titles(f"👑 Ты ведёшь · код {r.code}",
                          (f"готовы {ready} из {len(guests)}" if guests else "ждём зрителей") + f" · {link}")
        else:
            pl.set_titles(f"👑 Ведёт {self.host_name()}", f"код {r.code} · {link}")

    def update_ui(self):
        pl, r = self.player, self.room
        if pl is None or not pl.alive or r is None or not pl.prepared:
            return
        if self.is_host():
            if not self.started:
                lines = []
                for uid, m in r.members.items():
                    if uid == r.uid:
                        continue
                    s = {"ready": "готов(а)", "loading": f"загружает {m.get('pc', 0)}%",
                         "joined": "подключается"}.get(m.get("s"), m.get("s"))
                    lines.append(f"{m.get('n') or '?'} — {s}")
                pl.set_state("👥", "\n".join(lines) if lines else
                             f"Ждём зрителей…\nКод комнаты: {r.code}", True)
            elif not pl.countdown_at:
                pl.set_state("", "", False)
        else:
            self.guest_center(pl)
        self.update_titles()

    def guest_center(self, pl):
        """Что показать зрителю по центру: ожидание, отсчёт или ничего."""
        r = self.room
        st = r.st if r is not None else None
        if st is None or (not st["p"] and st["pos"] == 0):
            pl.set_state("⏳", f"Ждём, когда {self.host_name()} начнёт", False)
        elif st["p"] and r.room_now() < st["ts"]:
            pl.set_state(str((st["ts"] - r.room_now()) // 1000 + 1), "Старт для всех", False)
        else:
            pl.set_state("", "", False)

    # ---------- завершение ----------

    def confirm(self, title, message, yes, fn):
        def ui():
            act = self.activity()
            if act is None:
                return
            b = AlertDialogBuilder(act)
            b.set_title(title)
            b.set_message(message)
            b.set_positive_button(yes, lambda bb, w: (bb.dismiss(), self.run_safe(fn)))
            b.set_negative_button("Отмена", lambda bb, w: bb.dismiss())
            b.show()
        run_on_ui_thread(ui)

    def dialog_ok(self, title, message):
        def ui():
            act = self.activity()
            if act is None:
                BulletinHelper.show_info(f"{title}. {message}")
                return
            b = AlertDialogBuilder(act)
            b.set_title(title)
            b.set_message(message)
            b.set_positive_button("Ок", lambda bb, w: bb.dismiss())
            b.show()
        run_on_ui_thread(ui)

    def ask_close(self):
        if self.room is None:
            if self.player is not None:
                self.player.close()
            return
        if self.is_host():
            self.confirm("Закончить просмотр?", "Плеер закроется у всех в комнате.", "Закончить", self.end_session)
        else:
            self.confirm("Выйти из просмотра?", "Остальные продолжат без тебя. Вернуться можно по тому же коду.",
                         "Выйти", self.end_session)

    def close_room(self):
        r, self.room = self.room, None
        if r is not None:
            threading.Thread(target=r.close, daemon=True).start()

    def end_session(self):
        if self.is_host() and self.talk and self.get_setting("send_talk", False):
            did = getattr(self, "chat_did", 0)
            if did > 0:
                lines = [f"{fmt_time(at)} {who}: {t}" for at, who, t in sorted(self.talk, key=lambda x: x[0])]
                send_text(did, ("🎬 Обсуждали видео вместе:\n\n" + "\n".join(lines))[:4000])
        self.close_room()
        self.started = False
        pl, self.player = self.player, None
        if pl is not None:
            run_on_ui_thread(pl.close)

    def on_player_closed(self, pl):
        if self.player is not pl:
            return
        self.player = None
        if self.room is not None:
            self.end_session()

    # ---------- панель и настройки ----------

    def status_text(self):
        r = self.room
        if r is None:
            return "Совместный просмотр не идёт."
        people = ", ".join((m.get("n") or "?") for u, m in r.members.items() if u != r.uid) or "пока никого"
        role = "👑 Ты ведёшь" if self.is_host() else f"👑 Ведёт {self.host_name()}"
        return f"{role}\nКод комнаты: {r.code}\nВ комнате: {people}\nСвязь: {r.status}"

    def open_panel(self):
        def ui():
            act = self.activity()
            if act is None:
                return
            b = AlertDialogBuilder(act)
            b.set_title("🎬 Wtogether")
            if self.room is None:
                b.set_message("Смотреть вместе:\n• создать комнату — долгое нажатие на видео → Плагины → "
                              "«🎬 Смотреть вместе»;\n• зайти к другу — «Войти по коду».")
                b.set_positive_button("Войти по коду", lambda bb, w: (bb.dismiss(), self.ask_code()))
                b.set_negative_button("Закрыть", lambda bb, w: bb.dismiss())
            else:
                b.set_message(self.status_text())
                if self.player is None and self.mo is not None:
                    b.set_positive_button("Открыть плеер", lambda bb, w: (bb.dismiss(), self.open_player(self.mo)))
                elif self.is_host():
                    b.set_positive_button("Код комнаты", lambda bb, w: (bb.dismiss(), self.share_code()))
                b.set_negative_button("Закончить" if self.is_host() else "Выйти",
                                      lambda bb, w: (bb.dismiss(), self.run_safe(self.end_session)))
                b.set_neutral_button("Закрыть", lambda bb, w: bb.dismiss())
            b.show()
        run_on_ui_thread(ui)

    def create_settings(self):
        return [
            Header(text="Wtogether"),
            Text(text="🎟 Войти по коду", subtext="Зайти в комнату друга", accent=True,
                 on_click=lambda v: self.ask_code()),
            Text(text="Сейчас", subtext=self.status_text().replace("\n", " · "), icon="msg_info",
                 on_click=lambda v: self.open_panel()),
            Divider(),
            Header(text="Настройки"),
            Switch(key="ask_invite", text="Окно при получении кода в чате", default=True,
                   subtext="Когда друг присылает код комнаты — предложить войти"),
            Switch(key="send_talk", text="Отправлять обсуждение в чат", default=False,
                   subtext="Когда ведущий заканчивает, сообщения из плеера уходят в чат одним сообщением"),
            Switch(key="notify", text="Уведомления вне плеера", default=True),
            Divider(),
            Header(text="Как пользоваться"),
            Text(text="1. Создай комнату", subtext="Долгое нажатие на видео → Плагины → «🎬 Смотреть вместе». "
                                                   "Появится код"),
            Text(text="2. Позови", subtext="Отправь код в чат кнопкой или продиктуй. "
                                           "Друг: «Войти по коду» (здесь, в меню чата ⋮ или в боковом меню)"),
            Text(text="3. Начните", subtext="Когда все готовы — «▶ Начать для всех». Управляет только ведущий 👑"),
            Divider(),
            Text(text="🛠 Проверка работы", subtext="Если что-то не так — нажми и пришли текст",
                 on_click=lambda v: self.diagnostics()),
            Divider(text="Плагин нужен у всех участников. В чат ничего не пишется — связь идёт отдельно"),
        ]

    def diagnostics(self):
        r = self.room
        lines = [f"Версия {__version__}",
                 f"Приём кодов из чата: {'да' if self.nc_delegate else 'только хук'}"]
        if r is not None:
            c = r.client
            lines += [f"Комната: {r.code} ({r.role})",
                      f"Сервер: {c.endpoint if c and c.endpoint else 'не подключено'}",
                      f"Связь: {r.status}",
                      f"Участников: {len(r.members)}",
                      f"Состояние ведущего: {r.st}"]
            if r.role == "guest":
                lines.append(f"Сдвиг часов: {r.offset} мс" + (f", пинг {r.rtt} мс" if r.rtt is not None else ""))
        else:
            lines.append("Комнаты нет")
        if self.errors:
            lines += ["", "Ошибки:"] + self.errors[-10:]
        text = "\n".join(lines)

        def ui():
            act = self.activity()
            if act is None:
                return
            b = AlertDialogBuilder(act)
            b.set_title("🛠 Проверка Wtogether")
            b.set_message(text)
            b.set_positive_button("Скопировать", lambda bb, w: (bb.dismiss(), copy_to_clipboard(text)))
            b.set_negative_button("Закрыть", lambda bb, w: bb.dismiss())
            b.show()
        run_on_ui_thread(ui)

    # ---------- код комнаты в сообщениях ----------

    def on_update_hook(self, update_name, account, update):
        try:
            msg = getattr(update, "message", None)
            if msg is not None and not msg.out and ZWM in str(msg.message or ""):
                self.on_code_message(int(MessageObject.getDialogId(msg)), int(msg.id), str(msg.message))
        except Exception as e:
            self.log_err(f"on_update_hook: {e}")
        return HookResult()

    def on_updates_hook(self, container_name, account, updates):
        try:
            if container_name == "TL_updateShortMessage" and not updates.out and ZWM in str(updates.message or ""):
                self.on_code_message(int(updates.user_id), int(updates.id), str(updates.message))
        except Exception as e:
            self.log_err(f"on_updates_hook: {e}")
        return HookResult()

    def on_new_messages(self, did, messages):
        for i in range(messages.size()):
            mo = messages.get(i)
            try:
                text = str(mo.messageOwner.message or "")
                if not mo.isOut() and ZWM in text:
                    self.on_code_message(did, int(mo.getId()), text)
            except Exception as e:
                self.log_err(f"new message: {e}")

    def on_code_message(self, did, mid, text):
        if (did, mid) in self.seen:
            return
        self.seen.add((did, mid))
        cmd = zw_decode(text)
        if not cmd or cmd.get("t") != "code":
            return
        code = normalize_code(cmd.get("c"))
        if not code or not self.get_setting("ask_invite", True):
            return
        if self.room is not None and self.room.code == code:
            return
        name = "Друг"
        u = self.tg_user(did)
        if u is not None and u.first_name:
            name = u.first_name

        def ui():
            act = self.activity()
            if act is None:
                BulletinHelper.show_info(f"🎬 {name} зовёт смотреть вместе: код {code}")
                return
            b = AlertDialogBuilder(act)
            b.set_title(f"🎬 {name} зовёт смотреть вместе")
            b.set_message(f"Код комнаты: {code}\n\n{name} — ведущий 👑: он ставит паузу и перематывает, "
                          "у тебя всё повторяется само.")
            b.set_positive_button("Смотреть", lambda bb, w: (bb.dismiss(), self.run_safe(lambda: self.join_code(code))))
            b.set_negative_button("Позже", lambda bb, w: bb.dismiss())
            b.show()
        run_on_ui_thread(ui)
