def html_escape(s):
    return str(s).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


# ===== PURE START — чистый Python без Android, проверяется тестами в plugin/tools =====
import json
import random
import socket
import ssl
import threading
import time

NS = "wtogether4"
CODE_LEN = 4
# Публичные бесплатные MQTT-брокеры. Код комнаты указывает, на каком брокере она живёт.
BROKERS = [
    ("broker.emqx.io", [(1883, False), (8883, True)]),
    ("broker.hivemq.com", [(1883, False), (8883, True)]),
    ("test.mosquitto.org", [(1883, False), (8886, True)]),
]
KEEPALIVE = 30
ZW0, ZW1, ZWM = "​", "‌", "⁣"

SMALL_DRIFT = 150        # мс: меньше — не трогаем
BIG_DRIFT = 2000         # мс: больше — перематываем, между — подстраиваем скорость
NUDGE = 0.08             # насколько ускоряем/замедляем при подстройке
NUDGE_DONE = 80          # мс: до какого расхождения подтягиваем, раз начали


def now_ms():
    return int(time.time() * 1000)


def fmt_time(ms):
    s = max(0, int(ms) // 1000)
    h, s = divmod(s, 3600)
    m, s = divmod(s, 60)
    return f"{h}:{m:02d}:{s:02d}" if h else f"{m}:{s:02d}"


def new_code(broker_index):
    """4 цифры; первая говорит, на каком брокере комната (цифра % число брокеров)."""
    n = len(BROKERS)
    first = random.choice([d for d in "0123456789" if int(d) % n == broker_index])
    return first + "".join(random.choice("0123456789") for _ in range(CODE_LEN - 1))


def normalize_code(text):
    """«48 21» → «4821». None, если это не код."""
    code = "".join(c for c in str(text or "") if c.isdigit())
    return code if len(code) == CODE_LEN else None


def broker_of(code):
    return int(code[0]) % len(BROKERS)


def youtube_id(url):
    import re
    m = re.search(r"(?:youtu\.be/|youtube(?:-nocookie)?\.com/(?:watch\?(?:.*&)?v=|embed/|shorts/|live/|v/))([\w-]{11})",
                  url or "")
    return m.group(1) if m else None


def media_from_url(url):
    """Ссылка → описание источника для комнаты или None."""
    url = (url or "").strip()
    if not url.lower().startswith(("http://", "https://")):
        return None
    yt = youtube_id(url)
    if yt:
        return {"src": "yt", "yt": yt, "title": "YouTube"}
    name = url.split("?")[0].rstrip("/").split("/")[-1] or "Видео по ссылке"
    return {"src": "url", "url": url, "title": name[:60]}


def zw_encode(obj):
    raw = json.dumps(obj, separators=(",", ":")).encode("utf-8")
    return ZWM + "".join(ZW1 if bit == "1" else ZW0 for b in raw for bit in f"{b:08b}") + ZWM


def zw_decode(text):
    if not text:
        return None
    i = text.find(ZWM)
    j = text.find(ZWM, i + 1) if i >= 0 else -1
    if i < 0 or j < 0:
        return None
    bits = "".join("1" if c == ZW1 else "0" for c in text[i + 1:j] if c in (ZW0, ZW1))
    if not bits or len(bits) % 8:
        return None
    try:
        return json.loads(bytes(int(bits[k:k + 8], 2) for k in range(0, len(bits), 8)).decode("utf-8"))
    except Exception:
        return None


def expected_pos(st, room_now):
    """Где сейчас должен быть ведущий по последнему состоянию."""
    if not st["p"]:
        return st["pos"]
    return st["pos"] + max(0, room_now - st["ts"]) * st["r"]


def plan_correction(st, room_now, cur, playing, nudging=False):
    """Что сделать зрителю, чтобы совпасть с ведущим.
    Возвращает (play, seek_to или None, speed, nudging)."""
    target = expected_pos(st, room_now)
    diff = cur - target
    if not st["p"] or room_now < st["ts"]:          # пауза или ещё идёт отсчёт
        return False, (int(target) if abs(diff) > SMALL_DRIFT else None), st["r"], False
    if not playing:                                 # запускаемся — встаём точно на место
        return True, (int(target) if abs(diff) > NUDGE_DONE else None), st["r"], False
    if abs(diff) > BIG_DRIFT:
        return True, int(target), st["r"], False
    if abs(diff) > SMALL_DRIFT or (nudging and abs(diff) > NUDGE_DONE):
        return True, None, st["r"] * (1 - NUDGE if diff > 0 else 1 + NUDGE), True
    return True, None, st["r"], False


# ---------- минимальный MQTT 3.1.1 клиент (QoS 0, retain, last will) ----------

def _enc_len(n):
    out = bytearray()
    while True:
        b = n % 128
        n //= 128
        out.append(b | (0x80 if n else 0))
        if not n:
            return bytes(out)


def _enc_str(s):
    b = s.encode("utf-8") if isinstance(s, str) else bytes(s)
    return len(b).to_bytes(2, "big") + b


def _packet(first, body):
    return bytes([first]) + _enc_len(len(body)) + body


class MqttClient:
    """Сам переподключается, переподписывается и вызывает on_connect после каждого подключения."""

    def __init__(self, on_message, on_connect=None, on_status=None, log=None):
        self.on_message = on_message
        self.on_connect = on_connect
        self.on_status = on_status or (lambda s: None)
        self.log = log or (lambda s: None)
        self.client_id = "wt3-" + "".join(random.choice("0123456789abcdef") for _ in range(12))
        self.endpoints = []
        self.will = None
        self.subs = []
        self.sock = None
        self.lock = threading.Lock()
        self.connected = False
        self.running = False
        self.thread = None
        self.pid = 1
        self.endpoint = None

    def configure(self, endpoints, will=None):
        self.endpoints = list(endpoints)
        self.will = will

    def start(self):
        self.running = True
        self.thread = threading.Thread(target=self._run, name="wtogether-mqtt", daemon=True)
        self.thread.start()

    def stop(self, graceful=True):
        self.running = False
        s = self.sock
        if s is not None:
            try:
                if graceful and self.connected:
                    self._send(b"\xe0\x00")      # DISCONNECT — брокер не шлёт «завещание»
            except Exception:
                pass
            try:
                s.close()
            except Exception:
                pass

    def subscribe(self, topic):
        if topic not in self.subs:
            self.subs.append(topic)
        if self.connected:
            self._subscribe(topic)

    def publish(self, topic, payload, retain=False):
        if isinstance(payload, (dict, list)):
            payload = json.dumps(payload, separators=(",", ":"), ensure_ascii=False)
        if isinstance(payload, str):
            payload = payload.encode("utf-8")
        if not self.connected:
            return False
        try:
            self._send(_packet(0x30 | (1 if retain else 0), _enc_str(topic) + payload))
            return True
        except Exception as e:
            self.log(f"publish: {e}")
            self._drop()
            return False

    # --- внутреннее ---

    def _send(self, data):
        with self.lock:
            self.sock.sendall(data)

    def _subscribe(self, topic):
        self.pid = self.pid % 65000 + 1
        body = self.pid.to_bytes(2, "big") + _enc_str(topic) + b"\x00"
        self._send(_packet(0x82, body))

    def _drop(self):
        self.connected = False
        try:
            if self.sock is not None:
                self.sock.close()
        except Exception:
            pass

    def _connect(self, host, port, tls):
        raw = socket.create_connection((host, port), timeout=8)
        if tls:
            ctx = ssl.create_default_context()
            raw = ctx.wrap_socket(raw, server_hostname=host)
        raw.settimeout(1.0)
        self.sock = raw
        flags = 0x02  # clean session
        payload = _enc_str(self.client_id)
        if self.will:
            topic, msg, retain = self.will
            flags |= 0x04 | (0x20 if retain else 0)
            payload += _enc_str(topic) + _enc_str(msg if isinstance(msg, (bytes, bytearray)) else
                                                   json.dumps(msg, separators=(",", ":")))
        body = _enc_str("MQTT") + bytes([4, flags]) + KEEPALIVE.to_bytes(2, "big") + payload
        self._send(_packet(0x10, body))
        deadline = time.time() + 8
        buf = bytearray()
        while len(buf) < 4:
            if time.time() > deadline:
                raise OSError("нет ответа брокера")
            try:
                chunk = raw.recv(4 - len(buf))
            except socket.timeout:
                continue
            if not chunk:
                raise OSError("брокер закрыл соединение")
            buf += chunk
        if buf[0] != 0x20 or buf[3] != 0:
            raise OSError(f"брокер отказал: {buf[3]}")

    def _run(self):
        attempt = 0
        while self.running:
            ok = False
            for host, port, tls in self.endpoints:
                if not self.running:
                    return
                try:
                    self.on_status("подключаюсь")
                    self._connect(host, port, tls)
                    self.connected = True
                    self.endpoint = f"{host}:{port}"
                    attempt = 0
                    for t in self.subs:
                        self._subscribe(t)
                    self.on_status("на связи")
                    if self.on_connect:
                        try:
                            self.on_connect()
                        except Exception as e:
                            self.log(f"on_connect: {e}")
                    self._loop()
                    ok = True
                except Exception as e:
                    self.log(f"{host}:{port} — {e}")
                finally:
                    self._drop()
                if not self.running:
                    return
                if ok:
                    break
            self.on_status("нет связи, переподключаюсь")
            attempt += 1
            time.sleep(min(10, 1 + attempt))

    def _loop(self):
        buf = bytearray()
        last_rx = last_tx = time.time()
        while self.running and self.connected:
            now = time.time()
            if now - last_tx > KEEPALIVE / 2:
                self._send(b"\xc0\x00")       # PINGREQ
                last_tx = now
            if now - last_rx > KEEPALIVE * 1.5:
                raise OSError("брокер молчит")
            try:
                chunk = self.sock.recv(4096)
            except socket.timeout:
                continue
            if not chunk:
                raise OSError("соединение закрыто")
            last_rx = time.time()
            buf += chunk
            while True:
                if len(buf) < 2:
                    break
                mult, length, i = 1, 0, 1
                while True:
                    if i >= len(buf):
                        length = None
                        break
                    b = buf[i]
                    length += (b & 0x7F) * mult
                    mult *= 128
                    i += 1
                    if not b & 0x80:
                        break
                if length is None or len(buf) < i + length:
                    break
                first, body = buf[0], bytes(buf[i:i + length])
                del buf[:i + length]
                if first >> 4 == 3:                      # PUBLISH
                    tl = int.from_bytes(body[:2], "big")
                    topic = body[2:2 + tl].decode("utf-8", "replace")
                    pos = 2 + tl + (2 if (first >> 1) & 3 else 0)
                    try:
                        self.on_message(topic, body[pos:])
                    except Exception as e:
                        self.log(f"on_message: {e}")


# ---------- комната ----------

class Room:
    """Протокол комнаты поверх MQTT. Топики под NS/КОД/:
      room      — инфо: источник видео, ведущий (retained). Смена поля host = передача управления
      st        — состояние воспроизведения (retained, пишет текущий ведущий)
      end       — ведущий закончил (retained)
      p/<uid>   — присутствие участника (retained; «завещание» — ушёл)
      chat, react, wait — сообщения, реакции, просьба «подожди меня»
      ping/<uid>, pong/<uid> — сверка часов с ведущим
    """

    CLAIM_WAIT = 1.5    # с: сколько ждём, не занят ли код, прежде чем занять

    def __init__(self, uid, name, events, clock=now_ms, client_factory=None, endpoints=None):
        self.uid = int(uid)
        self.name = name
        self.ev = events
        self.clock = clock
        self.code = None
        self.role = None
        self.info = None
        self.st = None
        self.members = {}
        self.offset = 0
        self.rtt = None
        self.samples = []
        self.ended = False
        self.claimed = False
        self.foreign = None          # чужая комната с этим кодом, замеченная до занятия
        self.presence = {"s": "joined", "pc": 0}
        self._client_factory = client_factory or MqttClient
        self._endpoints = endpoints
        self.client = None
        self.status = "подключаюсь"

    # --- общее ---

    def t(self, suffix):
        return f"{NS}/{self.code}/{suffix}"

    def host_uid(self):
        return self.uid if self.role == "host" else int((self.info or {}).get("host") or 0)

    def room_now(self):
        return self.clock() + (self.offset if self.role == "guest" else 0)

    def _endpoints_for(self, code):
        if self._endpoints is not None:
            return self._endpoints
        host, ports = BROKERS[broker_of(code)]
        return [(host, p, tls) for p, tls in ports]

    def _emit(self, name, *args, **kw):
        cb = getattr(self.ev, name, None)
        if cb:
            cb(*args, **kw)

    def _start(self):
        self.client = self._client_factory(self._on_message, self._on_connect, self._on_status,
                                           getattr(self.ev, "on_log", None))
        self.client.configure(self._endpoints_for(self.code), (self.t(f"p/{self.uid}"), {"s": "gone"}, True))
        self.client.subscribe(f"{NS}/{self.code}/#")
        self.client.start()

    def _on_status(self, s):
        self.status = s
        self._emit("on_status", s)

    def _on_connect(self):
        self._publish_presence()
        if self.role == "host":
            if self.claimed:
                self._publish_room()
            else:
                threading.Timer(self.CLAIM_WAIT, self._claim).start()
        else:
            self.ping()

    def _claim(self):
        """Код свободен, если нет комнаты или её ведущий не в сети."""
        f = self.foreign
        if f and int(f.get("host") or 0) in self.members:
            self._emit("on_code_taken")
            return
        self.claimed = True
        self._publish_room()
        self._emit("on_claimed")

    def _publish_room(self):
        c = self.client
        if c is None:
            return
        c.publish(self.t("end"), b"", retain=True)
        c.publish(self.t("room"), self.info, retain=True)
        if self.st is not None:
            c.publish(self.t("st"), self.st, retain=True)

    def _publish_presence(self):
        p = dict(self.presence)
        p.update({"n": self.name, "host": self.role == "host", "ts": self.clock()})
        self.members[self.uid] = p
        if self.client is not None:
            self.client.publish(self.t(f"p/{self.uid}"), p, retain=True)

    # --- ведущий ---

    def host(self, code, info):
        self.role, self.code = "host", code
        self.info = dict(info, host=self.uid, hn=self.name, v=4)
        self.presence = {"s": "ready", "pc": 100}
        self._start()

    def publish_state(self, p, pos, r, ts=None):
        self.st = {"p": bool(p), "pos": int(pos), "r": float(r), "ts": int(ts if ts is not None else self.clock())}
        if self.client is not None and self.claimed:
            self.client.publish(self.t("st"), self.st, retain=True)

    def transfer(self, uid):
        """Отдать управление участнику uid."""
        if self.role != "host" or uid not in self.members:
            return False
        self.info = dict(self.info, host=int(uid), hn=self.members[uid].get("n") or "")
        self.client.publish(self.t("room"), self.info, retain=True)
        return True

    # --- зритель ---

    def join(self, code):
        self.role, self.code = "guest", code
        self._start()

    def ping(self):
        if self.client is not None and self.role == "guest":
            self.client.publish(self.t(f"ping/{self.uid}"), {"a": self.clock()})

    def set_progress(self, stage, pc=0):
        self.presence = {"s": stage, "pc": int(pc)}
        self._publish_presence()

    def ask_wait(self):
        if self.client is not None:
            self.client.publish(self.t("wait"), {"u": self.uid, "n": self.name})

    # --- все ---

    def chat(self, text, at):
        msg = {"u": self.uid, "n": self.name, "x": text[:300], "at": int(at)}
        if self.client is not None:
            self.client.publish(self.t("chat"), msg)
        return msg

    def react(self, emoji):
        if self.client is not None:
            self.client.publish(self.t("react"), {"u": self.uid, "n": self.name, "e": emoji[:8]})

    def close(self):
        """Ведущий — закончить для всех, зритель — выйти."""
        c = self.client
        if c is None:
            return
        if self.role == "host" and self.claimed:
            c.publish(self.t("end"), {"end": 1, "ts": self.clock()}, retain=True)
            c.publish(self.t("st"), b"", retain=True)
            c.publish(self.t("room"), b"", retain=True)
        c.publish(self.t(f"p/{self.uid}"), b"", retain=True)
        time.sleep(0.2)
        c.stop(graceful=True)
        self.client = None

    # --- входящие ---

    def _on_message(self, topic, payload):
        prefix = f"{NS}/{self.code}/"
        if not topic.startswith(prefix):
            return
        key = topic[len(prefix):]
        data = None
        if payload:
            try:
                data = json.loads(payload.decode("utf-8"))
            except Exception:
                return

        if key == "room":
            if not data:
                return
            new_host = int(data.get("host") or 0)
            if self.role == "host" and not self.claimed:
                if new_host != self.uid:
                    self.foreign = data
                return
            prev_host = self.host_uid()
            self.info = data
            if self.role == "guest" and new_host == self.uid:
                self.role = "host"
                self.claimed = True
                self.offset, self.samples = 0, []
                self._publish_presence()
                self._emit("on_role", "host")
            elif self.role == "host" and new_host != self.uid:
                self.role = "guest"
                self.samples = []
                self._publish_presence()
                self.ping()
                self._emit("on_role", "guest")
            elif self.role == "guest":
                if prev_host and prev_host != new_host:
                    self.samples = []
                    self.ping()
                    self._emit("on_host_changed", new_host)
                self._emit("on_room", data)
        elif key == "st":
            if data and self.role == "guest":
                self.st = data
                self._emit("on_state", data)
        elif key == "end":
            if data and self.role == "guest" and not self.ended:
                self.ended = True
                self._emit("on_end")
        elif key.startswith("p/"):
            try:
                uid = int(key[2:])
            except ValueError:
                return
            if uid == self.uid:
                return
            if not data or data.get("s") == "gone":
                if self.members.pop(uid, None) is not None:
                    self._emit("on_members", self.members, left=uid)
            else:
                new = uid not in self.members
                self.members[uid] = data
                self._emit("on_members", self.members, joined=uid if new else None)
        elif key == "chat":
            if data and int(data.get("u") or 0) != self.uid:
                self._emit("on_chat", data)
        elif key == "react":
            if data and int(data.get("u") or 0) != self.uid:
                self._emit("on_react", data)
        elif key == "wait":
            if data and self.role == "host" and int(data.get("u") or 0) != self.uid:
                self._emit("on_wait", data)
        elif key.startswith("ping/") and self.role == "host" and data:
            self.client.publish(self.t("pong/" + key[5:]), {"a": data.get("a"), "b": self.clock()})
        elif key == f"pong/{self.uid}" and self.role == "guest" and data:
            a, b = int(data.get("a") or 0), int(data.get("b") or 0)
            rtt = self.clock() - a
            if a and b and rtt >= 0:
                self.samples = (self.samples + [(rtt, b + rtt // 2 - self.clock())])[-8:]
                self.rtt, self.offset = min(self.samples)
# ===== PURE END =====


# ---------------- обёртки Java-интерфейсов ----------------

def listeners():
    """Классы-обёртки создаются при первом использовании, чтобы плагин грузился даже без них."""
    if hasattr(listeners, "cache"):
        return listeners.cache
    from android.media import MediaPlayer
    from android.widget import SeekBar
    from android.content import DialogInterface
    from android.view import View
    from android.webkit import ValueCallback

    class Prepared(dynamic_proxy(MediaPlayer.OnPreparedListener)):
        def __init__(self, fn):
            super().__init__()
            self.fn = fn

        def onPrepared(self, mp):
            self.fn(mp)

    class Completed(dynamic_proxy(MediaPlayer.OnCompletionListener)):
        def __init__(self, fn):
            super().__init__()
            self.fn = fn

        def onCompletion(self, mp):
            self.fn(mp)

    class Failed(dynamic_proxy(MediaPlayer.OnErrorListener)):
        def __init__(self, fn):
            super().__init__()
            self.fn = fn

        def onError(self, mp, what, extra):
            self.fn(mp, what, extra)
            return True

    class Info(dynamic_proxy(MediaPlayer.OnInfoListener)):
        def __init__(self, fn):
            super().__init__()
            self.fn = fn

        def onInfo(self, mp, what, extra):
            self.fn(mp, what, extra)
            return False

    class Touch(dynamic_proxy(View.OnTouchListener)):
        def __init__(self, fn):
            super().__init__()
            self.fn = fn

        def onTouch(self, v, e):
            self.fn(v, e)
            return True

    class Dismissed(dynamic_proxy(DialogInterface.OnDismissListener)):
        def __init__(self, fn):
            super().__init__()
            self.fn = fn

        def onDismiss(self, d):
            self.fn(d)

    class Value(dynamic_proxy(ValueCallback)):
        def __init__(self, fn):
            super().__init__()
            self.fn = fn

        def onReceiveValue(self, v):
            self.fn(v)

    class Seek(dynamic_proxy(SeekBar.OnSeekBarChangeListener)):
        def __init__(self, on_change, on_start, on_stop):
            super().__init__()
            self.on_change, self.on_start, self.on_stop = on_change, on_start, on_stop

        def onProgressChanged(self, sb, progress, from_user):
            self.on_change(int(progress), bool(from_user))

        def onStartTrackingTouch(self, sb):
            self.on_start()

        def onStopTrackingTouch(self, sb):
            self.on_stop(int(sb.getProgress()))

    class Keys(dynamic_proxy(DialogInterface.OnKeyListener)):
        def __init__(self, fn):
            super().__init__()
            self.fn = fn

        def onKey(self, dialog, code, event):
            if code == 4:  # «назад»
                if event.getAction() == 1:
                    self.fn()
                return True
            return False

    listeners.cache = dict(Prepared=Prepared, Completed=Completed, Failed=Failed, Info=Info, Touch=Touch,
                           Dismissed=Dismissed, Value=Value, Seek=Seek, Keys=Keys)
    return listeners.cache


def make_new_messages_observer(plugin):
    """Ловим сообщения с кодом комнаты, чтобы предложить войти."""
    class NewMessages(dynamic_proxy(NotificationCenter.NotificationCenterDelegate)):
        def __init__(self):
            super().__init__()

        def didReceivedNotification(self, id, account, args):
            try:
                if id == NotificationCenter.didReceiveNewMessages:
                    plugin.on_new_messages(int(args[0]), args[1])
            except Exception as e:
                plugin.log_err(f"didReceiveNewMessages: {e}")

    return NewMessages()


class JoinLinkHook(MethodHook):
    """Нажатие на ссылку https://wtogether.join/КОД открывает комнату, а не браузер."""
    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            for a in (param.args or []):
                if a is None:
                    continue
                s = str(a)
                i = s.find(JOIN_HOST)
                if i >= 0:
                    code = normalize_code(s[i + len(JOIN_HOST):i + len(JOIN_HOST) + 8])
                    if code:
                        try:
                            rt = str(param.method.getReturnType().getName())
                        except Exception:
                            rt = "void"
                        param.setResult(False if rt == "boolean" else None)
                        run_on_ui_thread(lambda: self.plugin.run_safe(lambda: self.plugin.join_code(code)))
                    return
        except Exception as e:
            self.plugin.log_err(f"ссылка: {e}")


