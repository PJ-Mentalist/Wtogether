    "hand": ["menu_feature_hands", "msg_handdown"],
    "crown": ["filled_crown_on", "filled_stream_crown"],
    "link": ["msg_link", "msg_link2"],
    "call": ["msg_calls", "calls_menu_phone"],
    "pip": ["menu_video_pip", "msg_voice_pip", "pip_video_expand"],
    "expand": ["pip_enlarge", "pip_video_expand", "msg_expand"],
    "rotate": ["ic_gofullscreen", "iv_fullscreen"],
    "send": ["msg_send", "ic_send"],
