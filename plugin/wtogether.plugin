"""
Wtogether для exteraGram: совместный просмотр видео из личного чата.

Как работает:
1. Долгое нажатие на видео в личке → Плагины → «Смотреть вместе». Другу уходит приглашение.
2. У друга появляется окно «Принять / Отказаться».
3. Оба открываете это видео. Пауза, перемотка и скорость становятся общими.
4. Меню чата (⋮) → «Wtogether» — панель: статус, синхронизация, завершение.
Служебные команды идут тихими сообщениями: у друга скрываются, у отправителя удаляются.
Плагин должен стоять у обоих.
"""
import json
import random
import re
import threading
import time

from base_plugin import BasePlugin, HookResult, HookStrategy, MenuItemData, MenuItemType, MethodHook
from hook_utils import find_class, get_private_field
from client_utils import send_request, send_text, get_messages_controller, get_last_fragment
from android_utils import run_on_ui_thread
from ui.bulletin import BulletinHelper
from ui.alert import AlertDialogBuilder
from ui.settings import Header, Switch, Text, Divider
from java.lang import Integer, Long
from org.telegram.tgnet import TLRPC
from org.telegram.messenger import MessageObject

__id__ = "wtogether"
__name__ = "Wtogether"
__description__ = "Смотрите видео из личного чата вместе: пауза, перемотка и скорость общие у обоих"
__author__ = "Wtogether"
__version__ = "1.1.0"
__icon__ = "exteraPlugins/1"
__category__ = ["media", "chats"]

TAG = "#wt1 "
TAG_RE = re.compile(r"#wt1 (\{.*\})", re.S)
# невидимая метка: команда кодируется символами нулевой ширины, текст остаётся чистым
ZW0, ZW1, ZWM = "​", "‌", "⁣"

SEND_DELAY = 0.45      # с: склеиваем частые события (перетаскивание ползунка) в одну команду
QUIET = 1.5            # с: после применения команды друга не отправляем «эхо»
DRIFT_MS = 700         # расхождение, после которого перематываем
DELETE_AFTER = 3.0     # с: через сколько удалять свою служебную команду с сервера


def now_ms():
    return int(time.time() * 1000)


def fmt_time(ms):
    s = max(0, int(ms) // 1000)
    h, s = divmod(s, 3600)
    m, s = divmod(s, 60)
    return f"{h}:{m:02d}:{s:02d}" if h else f"{m}:{s:02d}"


def zw_encode(obj):
    raw = json.dumps(obj, separators=(",", ":")).encode("utf-8")
    return ZWM + "".join(ZW1 if bit == "1" else ZW0 for b in raw for bit in f"{b:08b}") + ZWM


def zw_decode(text):
    i = text.find(ZWM)
    j = text.find(ZWM, i + 1) if i >= 0 else -1
    if i < 0 or j < 0:
        return None
    bits = "".join("1" if c == ZW1 else "0" for c in text[i + 1:j] if c in (ZW0, ZW1))
    if not bits or len(bits) % 8:
        return None
    try:
        return json.loads(bytes(int(bits[k:k + 8], 2) for k in range(0, len(bits), 8)).decode("utf-8"))
    except Exception:
        return None


def extract_cmd(text):
    if not text:
        return None
    if ZWM in text:
        cmd = zw_decode(text)
        if cmd:
            return cmd
    m = TAG_RE.search(text)
    if m:
        try:
            return json.loads(m.group(1))
        except Exception:
            return None
    return None


def has_cmd(text):
    return bool(text) and (ZWM in text or TAG in text)


class PlayerHook(MethodHook):
    def __init__(self, plugin, name):
        self.plugin = plugin
        self.name = name

    def after_hooked_method(self, param):
        try:
            self.plugin.on_player_event(param.thisObject, self.name)
        except Exception as e:
            self.plugin.logger.error(f"player hook {self.name}: {e}")


class WtogetherPlugin(BasePlugin):

    # ---------- жизненный цикл ----------

    def on_plugin_load(self):
        # session: {"dialog", "doc", "accepted", "since", "friend_open"}
        self.session = None
        self.remote = None       # последнее состояние от друга
        self.remote_at = 0       # когда оно пришло (мс)
        self.bound = None        # плеер, который сейчас синхронизируем
        self.quiet_until = 0.0
        self.seq = 0
        self.seen = set()
        self.pv_class = find_class("org.telegram.ui.PhotoViewer")

        self.add_hook("TL_updateNewMessage")
        self.add_hook("TL_updateShortMessage")

        self.add_menu_item(MenuItemData(
            menu_type=MenuItemType.MESSAGE_CONTEXT_MENU,
            text="🎬 Смотреть вместе",
            on_click=self.on_watch_click,
        ))
        self.add_menu_item(MenuItemData(
            menu_type=MenuItemType.CHAT_ACTION_MENU,
            text="🎬 Wtogether",
            on_click=lambda ctx: self.open_panel(),
        ))

        player_cls = find_class("org.telegram.ui.Components.VideoPlayer")
        if not player_cls:
            self.logger.error("VideoPlayer не найден: синхронизация не будет работать")
            return
        hooked = 0
        for name in ("play", "pause", "seekTo", "setPlaybackSpeed"):
            hooked += len(self.hook_all_methods(player_cls, name, PlayerHook(self, name)) or [])
        self.logger.info(f"Wtogether загружен, хуков плеера: {hooked}")

    # ---------- настройки и панель ----------

    def create_settings(self):
        items = [Header(text="Сейчас")]
        if self.session:
            items.append(Text(text=self.status_title(), subtext=self.status_line(), icon="msg_info",
                              on_click=lambda v: self.open_panel()))
            items.append(Text(text="Закончить совместный просмотр", red=True,
                              on_click=lambda v: self.stop_session(reload=True)))
        else:
            items.append(Text(text="Совместный просмотр не идёт",
                              subtext="Долгое нажатие на видео в личке → Плагины → «Смотреть вместе»"))
        items += [
            Divider(),
            Header(text="Уведомления"),
            Switch(key="notify", text="Действия друга", default=True,
                   subtext="Пауза, перемотка, подключение"),
            Switch(key="ask_invite", text="Спрашивать перед подключением", default=True,
                   subtext="Окно «Принять / Отказаться», когда друг зовёт смотреть"),
            Divider(),
            Header(text="Как пользоваться"),
            Text(text="1. Позови друга",
                 subtext="Долгое нажатие на видео в личке → Плагины → «Смотреть вместе»"),
            Text(text="2. Откройте видео оба",
                 subtext="Кто откроет позже, сам догонит позицию"),
            Text(text="3. Управляйте вместе",
                 subtext="Пауза, перемотка и скорость общие. Меню чата ⋮ → «Wtogether» — панель"),
            Divider(text="Плагин нужен у обоих собеседников"),
        ]
        return items

    def status_title(self):
        if not self.session:
            return "Совместный просмотр не идёт"
        name = self.friend_name(self.session["dialog"])
        return f"Смотришь вместе с {name}" if self.session.get("accepted") else f"Ждём ответа от {name}"

    def status_line(self):
        s = self.session
        if not s:
            return ""
        parts = []
        if not s.get("accepted"):
            parts.append("приглашение отправлено")
        elif s.get("friend_open"):
            parts.append("друг открыл видео")
        else:
            parts.append("друг ещё не открыл видео")
        if self.remote:
            ago = max(0, (now_ms() - self.remote_at) // 1000)
            when = "только что" if ago < 5 else (f"{ago} с назад" if ago < 60 else f"{ago // 60} мин назад")
            parts.append(("у друга играет " if self.remote["p"] else "у друга пауза на ") +
                         fmt_time(self.remote["pos"]) + f" ({when})")
        parts.append("у тебя видео открыто" if self.bound is not None and self.session_player()[1] is not None
                     else "у тебя видео не открыто")
        return " · ".join(parts)

    def dialog(self, title, message, positive=None, negative=None, neutral=None, red_negative=False):
        """Окно с кнопками. Каждая кнопка — (текст, функция или None)."""
        def ui():
            frag = get_last_fragment()
            act = frag.getParentActivity() if frag else None
            if act is None:
                BulletinHelper.show_info(f"{title}. {message}")
                return
            b = AlertDialogBuilder(act)
            b.set_title(title)
            b.set_message(message)

            def wrap(fn):
                def cb(builder, which):
                    builder.dismiss()
                    if fn:
                        try:
                            fn()
                        except Exception as e:
                            self.logger.error(f"dialog button: {e}")
                return cb

            if positive:
                b.set_positive_button(positive[0], wrap(positive[1]))
            if negative:
                b.set_negative_button(negative[0], wrap(negative[1]))
            if neutral:
                b.set_neutral_button(neutral[0], wrap(neutral[1]))
            b.show()
            if red_negative and negative:
                try:
                    b.make_button_red(AlertDialogBuilder.BUTTON_NEGATIVE)
                except Exception:
                    pass
        run_on_ui_thread(ui)

    def open_panel(self):
        if not self.session:
            self.dialog("🎬 Wtogether",
                        "Совместный просмотр не идёт.\n\n"
                        "Чтобы начать: долгое нажатие на видео в личке → Плагины → «Смотреть вместе». "
                        "Плагин нужен у обоих.",
                        positive=("Понятно", None))
            return
        self.dialog("🎬 " + self.status_title(),
                    self.status_line().replace(" · ", "\n"),
                    positive=("Подтянуть друга ко мне", self.resync),
                    negative=("Закончить", lambda: self.stop_session()),
                    neutral=("Закрыть", None),
                    red_negative=True)

    # ---------- действия ----------

    def on_watch_click(self, context):
        msg = context.get("message")
        if msg is None or not msg.isVideo():
            BulletinHelper.show_error("Выбери сообщение с видео")
            return
        did = int(msg.getDialogId())
        if did <= 0:
            BulletinHelper.show_error("Пока работает только в личных чатах")
            return
        doc = self.doc_of(msg)
        if not doc:
            BulletinHelper.show_error("Не удалось распознать видео")
            return
        self.start_session(did, doc, accepted=False)
        text = ("🎬 Давай посмотрим это видео вместе!\n"
                "Открой его — пауза и перемотка будут общими.\n"
                "Нужен плагин Wtogether для exteraGram." + zw_encode({"t": "invite", "d": doc}))
        try:
            send_text(did, text, replyToMsg=msg)
        except Exception:
            send_text(did, text)
        BulletinHelper.show_success(f"Приглашение отправлено {self.friend_name(did)}")

    def resync(self):
        if not self.session or self.bound is None or self.session_player()[1] is None:
            BulletinHelper.show_error("Сначала открой видео")
            return
        run_on_ui_thread(lambda: self.send_state(force=True))
        BulletinHelper.show_success("Друг перемотан к твоей позиции")

    def stop_session(self, reload=False):
        if not self.session:
            return
        self.send_cmd({"t": "stop"})
        self.clear_session()
        BulletinHelper.show_info("Совместный просмотр закончен")
        if reload:
            self.set_setting("_state", now_ms(), reload_settings=True)

    def start_session(self, did, doc, accepted=True):
        self.session = {"dialog": did, "doc": doc, "accepted": accepted, "since": now_ms(), "friend_open": False}
        self.remote = None
        self.bound = None

    def clear_session(self):
        self.session = None
        self.remote = None
        self.bound = None

    # ---------- плеер ----------

    def doc_of(self, msg):
        try:
            doc = msg.getDocument()
            return int(doc.id) if doc is not None else 0
        except Exception:
            return 0

    def viewer(self):
        """Открытый просмотрщик Telegram, его плеер и текущее сообщение."""
        try:
            PhotoViewer = self.pv_class
            if PhotoViewer is None:
                return None, None, None
            try:
                if not PhotoViewer.getDeclaredMethod("hasInstance").invoke(None):
                    return None, None, None
            except Exception:
                pass
            pv = PhotoViewer.getDeclaredMethod("getInstance").invoke(None)
            if pv is None:
                return None, None, None
            return pv, get_private_field(pv, "videoPlayer"), get_private_field(pv, "currentMessageObject")
        except Exception as e:
            self.logger.error(f"viewer: {e}")
            return None, None, None

    def session_player(self):
        """Плеер, если сейчас открыто именно видео совместного просмотра."""
        if not self.session:
            return None, None
        pv, player, msg = self.viewer()
        if player is None or msg is None:
            return None, None
        if int(msg.getDialogId()) != self.session["dialog"] or self.doc_of(msg) != self.session["doc"]:
            return None, None
        return pv, player

    def on_player_event(self, player, name):
        if not self.session:
            return
        pv, sp = self.session_player()
        if sp is None or not sp.equals(player):
            return
        if self.bound is None or not self.bound.equals(player):
            self.bound = player
            self.on_video_opened()
            return
        if time.time() < self.quiet_until:
            return
        self.seq += 1
        s = self.seq
        threading.Timer(SEND_DELAY, lambda: run_on_ui_thread(lambda: self.send_state(seq=s))).start()

    def on_video_opened(self):
        self.quiet_until = time.time() + QUIET
        if not self.session.get("accepted"):
            # открыл видео из приглашения — считаем, что принял
            self.session["accepted"] = True
            self.send_cmd({"t": "accept"})
        name = self.friend_name(self.session["dialog"])
        if self.remote:
            BulletinHelper.show_info(f"🔗 Подключаюсь к {name}…")
            run_on_ui_thread(self.apply_remote, 800)
        else:
            BulletinHelper.show_info(f"🔗 Вместе с {name}. Ждём, когда друг откроет видео")
            self.send_cmd({"t": "ask"})

    def read_state(self):
        player = self.bound
        if player is None:
            return None
        try:
            playing = bool(player.isPlaying())
            pos = int(player.getCurrentPosition())
        except Exception as e:
            self.logger.error(f"read_state: {e}")
            return None
        try:
            rate = float(player.getPlaybackSpeed())
        except Exception:
            rate = 1.0
        return {"p": playing, "pos": pos, "r": rate, "ts": now_ms()}

    def send_state(self, seq=None, force=False):
        if seq is not None and seq != self.seq:
            return
        if not force and time.time() < self.quiet_until:
            return
        pv, sp = self.session_player()
        if sp is None or self.bound is None or not sp.equals(self.bound):
            return
        st = self.read_state()
        if st:
            st["t"] = "st"
            self.send_cmd(st)

    def apply_remote(self):
        st = self.remote
        pv, player = self.session_player()
        if not st or player is None:
            return
        self.bound = player
        self.quiet_until = time.time() + QUIET
        elapsed = min(max(0, now_ms() - st["ts"]), 60000)
        target = st["pos"] + (elapsed * st["r"] if st["p"] else 0)
        try:
            try:
                if abs(float(player.getPlaybackSpeed()) - st["r"]) > 0.01:
                    player.setPlaybackSpeed(float(st["r"]))
            except Exception:
                pass
            if abs(int(player.getCurrentPosition()) - target) > DRIFT_MS:
                player.seekTo(int(target))
            if bool(player.isPlaying()) != st["p"]:
                self.toggle(pv, player, st["p"])
        except Exception as e:
            self.logger.error(f"apply_remote: {e}")

    def toggle(self, pv, player, want_play):
        # через просмотрщик, чтобы кнопка ▶/⏸ на экране тоже переключилась
        try:
            m = self.pv_class.getDeclaredMethod("toggleVideoPlayer")
            m.setAccessible(True)
            m.invoke(pv)
            return
        except Exception as e:
            self.logger.info(f"toggleVideoPlayer недоступен: {e}")
        if want_play:
            player.play()
        else:
            player.pause()

    # ---------- служебные сообщения ----------

    def human(self, cmd):
        t = cmd.get("t")
        if t == "st":
            return ("▶️ смотрим с " if cmd["p"] else "⏸ пауза на ") + fmt_time(cmd["pos"])
        return {"ask": "🔄 подключаюсь", "stop": "⏹ просмотр закончен",
                "accept": "✅ принял(а) приглашение", "decline": "🙅 отказался(ась)"}.get(t, t or "")

    def send_cmd(self, cmd, did=None, doc=None):
        sess = self.session
        did = did or (sess and sess["dialog"])
        doc = doc or (sess and sess["doc"])
        if not did:
            return
        cmd["d"] = doc
        text = "🎬 Wtogether: " + self.human(cmd) + "\n" + TAG + json.dumps(cmd, separators=(",", ":"))
        try:
            req = TLRPC.TL_messages_sendMessage()
            req.peer = get_messages_controller().getInputPeer(Long(did))
            req.message = text
            req.random_id = random.getrandbits(62)
            req.no_webpage = True
            req.silent = True
            send_request(req, self.after_sent)
        except Exception as e:
            self.logger.error(f"send_cmd: {e}")

    def after_sent(self, resp, err):
        if err is not None or resp is None:
            self.logger.error(f"служебное сообщение не ушло: {getattr(err, 'text', err)}")
            return
        mid = 0
        try:
            if hasattr(resp, "updates") and resp.updates is not None:
                for i in range(resp.updates.size()):
                    u = resp.updates.get(i)
                    if u.getClass().getSimpleName() == "TL_updateMessageID":
                        mid = int(u.id)
                        break
                    if getattr(u, "message", None) is not None and hasattr(u.message, "id"):
                        mid = int(u.message.id)
            elif hasattr(resp, "id"):
                mid = int(resp.id)
        except Exception as e:
            self.logger.error(f"after_sent: {e}")
        if mid:
            threading.Timer(DELETE_AFTER, lambda: self.delete_remote(mid)).start()

    def delete_remote(self, mid):
        try:
            req = TLRPC.TL_messages_deleteMessages()
            req.revoke = True
            req.id.add(Integer(mid))
            send_request(req, lambda r, e: None)
        except Exception as e:
            self.logger.error(f"delete_remote: {e}")

    # ---------- входящие ----------

    def on_update_hook(self, update_name, account, update):
        try:
            msg = getattr(update, "message", None)
            if msg is None or msg.out or not has_cmd(msg.message):
                return HookResult()
            did = int(MessageObject.getDialogId(msg))
            if self.handle_incoming(did, int(msg.id), msg.message):
                return HookResult(strategy=HookStrategy.CANCEL)
        except Exception as e:
            self.logger.error(f"on_update_hook: {e}")
        return HookResult()

    def on_updates_hook(self, container_name, account, updates):
        try:
            if container_name != "TL_updateShortMessage" or updates.out or not has_cmd(updates.message):
                return HookResult()
            if self.handle_incoming(int(updates.user_id), int(updates.id), updates.message):
                return HookResult(strategy=HookStrategy.CANCEL)
        except Exception as e:
            self.logger.error(f"on_updates_hook: {e}")
        return HookResult()

    def friend_name(self, did):
        try:
            u = get_messages_controller().getUser(Long(did))
            if u is not None and u.first_name:
                return u.first_name
        except Exception:
            pass
        return "друг"

    def notify(self, text):
        if self.get_setting("notify", True):
            BulletinHelper.show_info(text)

    def on_invite(self, did, doc):
        name = self.friend_name(did)
        self.start_session(did, doc, accepted=False)
        if not self.get_setting("ask_invite", True):
            self.session["accepted"] = True
            self.send_cmd({"t": "accept"})
            self.notify(f"🎬 {name} зовёт смотреть вместе. Открой видео в чате")
            return

        def accept():
            if self.session and self.session["dialog"] == did:
                self.session["accepted"] = True
            self.send_cmd({"t": "accept"}, did, doc)
            BulletinHelper.show_success("Открой видео в чате — над приглашением")

        def decline():
            self.send_cmd({"t": "decline"}, did, doc)
            if self.session and self.session["dialog"] == did:
                self.clear_session()

        self.dialog(f"🎬 {name} зовёт смотреть вместе",
                    "Откройте это видео оба: пауза, перемотка и скорость будут общими.\n\n"
                    "Видео — в сообщении, на которое ответил друг.",
                    positive=("Смотреть", accept),
                    negative=("Отказаться", decline),
                    neutral=("Позже", None),
                    red_negative=True)

    def handle_incoming(self, did, mid, text):
        """Разбирает команду друга. True — скрыть сообщение из чата."""
        key = (did, mid)
        if key in self.seen:
            return True
        self.seen.add(key)
        if len(self.seen) > 500:
            self.seen.clear()
        cmd = extract_cmd(text)
        if not cmd:
            return False
        t = cmd.get("t")
        doc = int(cmd.get("d") or 0)
        name = self.friend_name(did)
        mine = self.session and self.session["dialog"] == did

        if t == "invite":
            self.on_invite(did, doc)
            return False  # приглашение остаётся видимым

        if t == "accept":
            if mine:
                self.session["accepted"] = True
                self.notify(f"✅ {name} принял(а) приглашение. Открывай видео")
            return True

        if t == "decline":
            if mine:
                self.clear_session()
                self.dialog("Wtogether", f"{name} отказался(ась) от совместного просмотра.",
                            positive=("Ок", None))
            return True

        if t == "stop":
            if mine:
                self.clear_session()
                self.notify(f"⏹ {name} закончил(а) совместный просмотр")
            return True

        # команда к другому видео или после перезапуска: подхватываем сессию
        if not mine or self.session["doc"] != doc:
            self.start_session(did, doc, accepted=True)
        self.session["accepted"] = True
        self.session["friend_open"] = True

        if t == "ask":
            self.notify(f"🔗 {name} открыл(а) видео")
            run_on_ui_thread(lambda: self.send_state(force=True))
            return True

        if t == "st":
            prev = self.remote
            self.remote = {"p": bool(cmd.get("p")), "pos": int(cmd.get("pos") or 0),
                           "r": float(cmd.get("r") or 1.0), "ts": int(cmd.get("ts") or now_ms())}
            self.remote_at = now_ms()
            if prev is None or prev["p"] != self.remote["p"]:
                self.notify(f"{name}: " + self.human(cmd))
            run_on_ui_thread(self.apply_remote)
            return True

        return True
